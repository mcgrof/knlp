# knlp plugin configuration fragment with KVTide bench dependencies
#
# kdevops resolves fragments from ~/.config/kdevops/defconfigs/configs
# (or $KDEVOPS_CONFIG_PATH), not from the plugin install directory --
# copy this file there first, then: make defconfig-<base>+knlp-kvtide

CONFIG_KDEVOPS_USER_WORKFLOW_KNLP=y
CONFIG_WORKFLOW_KNLP_KVTIDE=y
# eBPF-capable kernel under test: the kvio tracers ride along with
# KVTide benches, and they need BTF (fentry/tp_btf + module BTF).
# The bootlinux ebpf fragment carries the whole DEBUG_INFO_BTF block.
CONFIG_BOOTLINUX_FRAGMENT_EBPF=y
