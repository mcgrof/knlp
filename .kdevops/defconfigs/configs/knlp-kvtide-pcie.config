# knlp plugin configuration for physical PCIe KVTide runs
#
# Copy this fragment into kdevops' defconfig fragment directory before
# composing it with a declared-hosts bare-metal configuration.

CONFIG_KDEVOPS_USER_WORKFLOW_KNLP=y
CONFIG_WORKFLOW_KNLP_KVTIDE=y
CONFIG_WORKFLOW_KNLP_KVTIDE_UPCIE_CUDA=y
CONFIG_WORKFLOW_KNLP_KVTIDE_UPCIE_RELEASE="v0.8.0"
CONFIG_WORKFLOW_KNLP_KVTIDE_UPCIE_DKMS_VERSION="0.2.0"
CONFIG_BOOTLINUX_FRAGMENT_EBPF=y
