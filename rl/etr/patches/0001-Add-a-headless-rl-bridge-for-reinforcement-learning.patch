+// ====================================================================
+//			headless (--rl) entry points
+// ====================================================================
+// These mirror Enter() and Loop() minus everything that needs a
+// window, a GL context or an audio device, so a headless step runs the
+// exact steering and physics code the rendered game runs.
+
+void CRacing::HeadlessEnter() {
+	CControl *ctrl = g_game.player->ctrl;
+
+	ctrl->turn_fact = 0.0;
+	ctrl->turn_animation = 0.0;
+	ctrl->is_braking = false;
+	ctrl->is_paddling = false;
+	ctrl->jumping = false;
+	ctrl->jump_charging = false;
+
+	key_paddling = false;
+	key_braking = false;
+	left_turn = false;
+	right_turn = false;
+	key_charging = false;
+	trick_modifier = false;
+	stick_paddling = false;
+	stick_braking = false;
+	stick_turn = false;
+	stick_turnfact = 0.0;
+
+	ctrl->Init();
+	g_game.raceaborted = false;
+	g_game.finish = false;
+}
+
+void CRacing::HeadlessStep(float turn, bool brake, bool paddle, bool jump, float time_step) {
+	CControl *ctrl = g_game.player->ctrl;
+
+	// Feed the same flip-flops the keyboard/joystick handlers set.
+	stick_turn = (turn != 0.0f);
+	stick_turnfact = clamp(-1.0f, turn, 1.0f);
+	left_turn = false;
+	right_turn = false;
+	key_paddling = paddle;
+	key_braking = brake;
+	key_charging = jump;
+
+	double ycoord = Course.FindYCoord(ctrl->cpos.x, ctrl->cpos.z);
+	bool airborne = (bool)(ctrl->cpos.y > (ycoord + JUMP_MAX_START_HEIGHT));
+
+	CalcTrickControls(ctrl, time_step, airborne);
+	if (!g_game.finish) CalcSteeringControls(ctrl, time_step);
+	else CalcFinishControls(ctrl, time_step, airborne);
+
+	ctrl->UpdatePlayerPos(time_step);
+
+	UpdateWind(time_step);
+	if (g_game.finish == false) g_game.time += time_step;
+}
