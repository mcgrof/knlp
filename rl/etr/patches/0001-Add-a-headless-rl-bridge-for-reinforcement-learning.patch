@@ -0,0 +1,461 @@
+/* --------------------------------------------------------------------
+EXTREME TUXRACER
+
+Headless reinforcement-learning bridge (--rl).
+
+Drives the race physics without rendering so an external learner can
+reset and step the game faster than real time. The wire protocol is
+one request per line on stdin and one JSON object per line on stdout:
+
+  info
+  reset seed=<u32> course=<dir> [group=default] [wind=0] [light=0]
+        [mirror=0] [dt=0.016667]
+  step turn=<-1..1> brake=<0|1> paddle=<0|1> jump=<0|1>
+       [ticks=1] [dt=0.016667]
+  quit
+
+Everything the game normally prints to stdout is redirected to
+stderr so stdout carries only protocol replies.
+
+This program is free software; you can redistribute it and/or
+modify it under the terms of the GNU General Public License
+as published by the Free Software Foundation; either version 2
+of the License, or (at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+---------------------------------------------------------------------*/
+
+#ifdef HAVE_CONFIG_H
+#include <etr_config.h>
+#endif
+
+#include "rl_bridge.h"
+#include "bh.h"
+#include "course.h"
+#include "env.h"
+#include "game_ctrl.h"
+#include "keyframe.h"
+#include "particles.h"
+#include "physics.h"
+#include "racing.h"
+#include "tux.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <iomanip>
+#include <iostream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace {
+
+const float RL_DEFAULT_DT = 1.0f / 60.0f;
+const int RL_MAX_TICKS = 100000;
+const std::size_t RL_NEAREST = 4;
+
+// Forward terrain probe fan, in course coordinates (forward is -z).
+const double PROBE_AHEAD[] = {3.0, 6.0, 12.0, 24.0};
+const double PROBE_SIDE[] = {-6.0, -3.0, 0.0, 3.0, 6.0};
+
+struct RlState {
+	bool loaded;
+	bool have_course;
+	long tick;
+	float dt;
+	std::string group;
+	std::string dir;
+	RlState() : loaded(false), have_course(false), tick(0), dt(RL_DEFAULT_DT) {}
+};
+
+RlState rl;
+
+typedef std::map<std::string, std::string> Args;
+
+double ArgF(const Args& a, const char* key, double def) {
+	Args::const_iterator it = a.find(key);
+	if (it == a.end() || it->second.empty()) return def;
+	return std::atof(it->second.c_str());
+}
+
+long ArgI(const Args& a, const char* key, long def) {
+	Args::const_iterator it = a.find(key);
+	if (it == a.end() || it->second.empty()) return def;
+	return std::atol(it->second.c_str());
+}
+
+std::string ArgS(const Args& a, const char* key, const std::string& def) {
+	Args::const_iterator it = a.find(key);
+	if (it == a.end()) return def;
+	return it->second;
+}
+
+std::string JsonStr(const std::string& s) {
+	std::string out = "\"";
+	for (std::size_t i = 0; i < s.size(); i++) {
+		char c = s[i];
+		if (c == '"' || c == '\\') { out += '\\'; out += c; }
+		else if (c == '\n') out += "\\n";
+		else if ((unsigned char)c < 0x20) out += ' ';
+		else out += c;
+	}
+	return out + "\"";
+}
+
+class Json {
+	std::ostringstream os;
+	bool first;
+public:
+	Json() : first(true) { os << std::setprecision(12); os << '{'; }
+	void Key(const char* k) {
+		if (!first) os << ',';
+		first = false;
+		os << '"' << k << "\":";
+	}
+	Json& Num(const char* k, double v) {
+		Key(k);
+		if (std::isfinite(v)) os << v; else os << "null";
+		return *this;
+	}
+	Json& Int(const char* k, long v) { Key(k); os << v; return *this; }
+	Json& Bool(const char* k, bool v) { Key(k); os << (v ? "true" : "false"); return *this; }
+	Json& Str(const char* k, const std::string& v) { Key(k); os << JsonStr(v); return *this; }
+	Json& Raw(const char* k, const std::string& v) { Key(k); os << v; return *this; }
+	std::string Done() { os << '}'; return os.str(); }
+};
+
+std::string Vec3(const TVector3d& v) {
+	std::ostringstream os;
+	os << std::setprecision(12) << '[' << v.x << ',' << v.y << ',' << v.z << ']';
+	return os.str();
+}
+
+std::string Nums(const std::vector<double>& v) {
+	std::ostringstream os;
+	os << std::setprecision(12) << '[';
+	for (std::size_t i = 0; i < v.size(); i++) {
+		if (i) os << ',';
+		os << v[i];
+	}
+	os << ']';
+	return os.str();
+}
+
+std::string Rows(const std::vector<std::vector<double> >& rows) {
+	std::string out = "[";
+	for (std::size_t i = 0; i < rows.size(); i++) {
+		if (i) out += ',';
+		out += Nums(rows[i]);
+	}
+	return out + "]";
+}
+
+std::string Error(const std::string& msg) {
+	Json j;
+	j.Bool("ok", false).Str("error", msg);
+	return j.Done();
+}
+
+bool LoadStaticData(std::string& err) {
+	if (rl.loaded) return true;
+	param.perf_level = 1;		// no particles; they are visual only
+	Course.MakeStandardPolyhedrons();
+	if (!Char.LoadCharacterList()) { err = "could not load characters"; return false; }
+	Course.LoadObjectTypes();
+	if (!Course.LoadTerrainTypes()) { err = "could not load terrain types"; return false; }
+	if (!Env.LoadEnvironmentList()) { err = "could not load environment list"; return false; }
+	if (!Course.LoadCourseList()) { err = "could not load course list"; return false; }
+	Players.LoadPlayers();
+	Players.AllocControl(0);
+	g_game.player = Players.GetPlayer(0);
+	g_game.character = nullptr;
+	for (std::size_t i = 0; i < Char.CharList.size(); i++) {
+		if (Char.CharList[i].shape != nullptr) {
+			g_game.character = &Char.CharList[i];
+			break;
+		}
+	}
+	if (g_game.character == nullptr) { err = "no character shape loaded"; return false; }
+	rl.loaded = true;
+	return true;
+}
+
+bool CourseFinished() {
+	const CControl* ctrl = g_game.player->ctrl;
+	return g_game.finish || (-ctrl->cpos.z >= Course.GetPlayDimensions().y);
+}
+
+double ProbeFriction(double x, double z) {
+	static std::vector<double> w;
+	if (w.size() != Course.TerrList.size()) w.resize(Course.TerrList.size());
+	Course.GetSurfaceType(x, z, &w[0]);
+	double f = 0.0;
+	for (std::size_t i = 0; i < Course.TerrList.size(); i++)
+		f += w[i] * Course.TerrList[i].friction;
+	return f;
+}
+
+std::string Observation(bool done) {
+	const CControl* ctrl = g_game.player->ctrl;
+	const TVector2d& size = Course.GetDimensions();
+	const TVector2d& play = Course.GetPlayDimensions();
+
+	// Terrain height (relative to the player) and friction on a fixed
+	// forward fan, clamped to the course rectangle.
+	std::vector<double> heights, fricts;
+	for (std::size_t a = 0; a < sizeof(PROBE_AHEAD) / sizeof(PROBE_AHEAD[0]); a++) {
+		for (std::size_t s = 0; s < sizeof(PROBE_SIDE) / sizeof(PROBE_SIDE[0]); s++) {
+			double px = clamp(0.0, ctrl->cpos.x + PROBE_SIDE[s], size.x);
+			double pz = clamp(-size.y, ctrl->cpos.z - PROBE_AHEAD[a], 0.0);
+			heights.push_back(Course.FindYCoord(px, pz) - ctrl->cpos.y);
+			fricts.push_back(ProbeFriction(px, pz));
+		}
+	}
+
+	// Nearest collidable objects (trees) ahead of or beside the player.
+	std::vector<std::pair<double, std::size_t> > order;
+	for (std::size_t i = 0; i < Course.CollArr.size(); i++) {
+		double dx = Course.CollArr[i].pt.x - ctrl->cpos.x;
+		double dz = Course.CollArr[i].pt.z - ctrl->cpos.z;
+		if (dz > 4.0) continue;		// already behind us
+		order.push_back(std::make_pair(dx * dx + dz * dz, i));
+	}
+	std::size_t keep = std::min(RL_NEAREST, order.size());
+	std::partial_sort(order.begin(), order.begin() + keep, order.end());
+	std::vector<std::vector<double> > trees;
+	for (std::size_t k = 0; k < keep; k++) {
+		const TCollidable& t = Course.CollArr[order[k].second];
+		std::vector<double> row;
+		row.push_back(t.pt.x - ctrl->cpos.x);
+		row.push_back(t.pt.z - ctrl->cpos.z);
+		row.push_back(t.diam);
+		trees.push_back(row);
+	}
+
+	// Nearest collectable items still on the course.
+	order.clear();
+	for (std::size_t i = 0; i < Course.NocollArr.size(); i++) {
+		if (Course.NocollArr[i].collectable != 1) continue;
+		double dx = Course.NocollArr[i].pt.x - ctrl->cpos.x;
+		double dz = Course.NocollArr[i].pt.z - ctrl->cpos.z;
+		if (dz > 4.0) continue;
+		order.push_back(std::make_pair(dx * dx + dz * dz, i));
+	}
+	keep = std::min(RL_NEAREST, order.size());
+	std::partial_sort(order.begin(), order.begin() + keep, order.end());
+	std::vector<std::vector<double> > items;
+	for (std::size_t k = 0; k < keep; k++) {
+		const TItem& t = Course.NocollArr[order[k].second];
+		std::vector<double> row;
+		row.push_back(t.pt.x - ctrl->cpos.x);
+		row.push_back(t.pt.z - ctrl->cpos.z);
+		items.push_back(row);
+	}
+
+	int remaining = 0;
+	for (std::size_t i = 0; i < Course.NocollArr.size(); i++)
+		if (Course.NocollArr[i].collectable == 1) remaining++;
+
+	TPlane plane = Course.GetLocalCoursePlane(ctrl->cpos);
+
+	Json j;
+	j.Bool("ok", true)
+	.Int("tick", rl.tick)
+	.Num("time", g_game.time)
+	.Raw("pos", Vec3(ctrl->cpos))
+	.Raw("vel", Vec3(ctrl->cvel))
+	.Num("speed", ctrl->cvel.Length())
+	.Num("way", ctrl->way)
+	.Num("progress", -ctrl->cpos.z)
+	.Int("herring", g_game.herring)
+	.Int("items_left", remaining)
+	.Int("collisions", ctrl->collisions)
+	.Bool("airborne", ctrl->cairborne)
+	.Bool("braking", ctrl->is_braking)
+	.Bool("paddling", ctrl->is_paddling)
+	.Bool("jumping", ctrl->jumping)
+	.Num("turn", ctrl->turn_fact)
+	.Num("friction", ProbeFriction(ctrl->cpos.x, ctrl->cpos.z))
+	.Raw("nml", Vec3(plane.nml))
+	.Bool("finish", g_game.finish)
+	.Bool("done", done)
+	.Raw("size", "[" + std::to_string(size.x) + "," + std::to_string(size.y) + "]")
+	.Raw("play", "[" + std::to_string(play.x) + "," + std::to_string(play.y) + "]")
+	.Raw("probe_h", Nums(heights))
+	.Raw("probe_f", Nums(fricts))
+	.Raw("trees", Rows(trees))
+	.Raw("items", Rows(items));
+	return j.Done();
+}
+
+std::string DoInfo() {
+	std::string err;
+	if (!LoadStaticData(err)) return Error(err);
+	std::string courses = "[";
+	bool first = true;
+	for (std::unordered_map<std::string, CCourseList>::iterator g = Course.CourseLists.begin();
+	        g != Course.CourseLists.end(); ++g) {
+		for (std::size_t i = 0; i < g->second.size(); i++) {
+			const TCourse& c = g->second[i];
+			Json cj;
+			cj.Str("group", g->first)
+			.Str("dir", c.dir)
+			.Str("name", c.name.toAnsiString())
+			.Num("width", c.size.x)
+			.Num("length", c.size.y)
+			.Num("play_width", c.play_size.x)
+			.Num("play_length", c.play_size.y)
+			.Num("start_x", c.start.x)
+			.Num("start_z", -c.start.y)
+			.Bool("use_keyframe", c.use_keyframe);
+			if (!first) courses += ',';
+			first = false;
+			courses += cj.Done();
+		}
+	}
+	courses += "]";
+	Json j;
+	j.Bool("ok", true)
+	.Str("version", ETR_VERSION_STRING)
+	.Str("character", g_game.character->name)
+	.Str("data_dir", param.data_dir)
+	.Num("default_dt", RL_DEFAULT_DT)
+	.Raw("courses", courses);
+	return j.Done();
+}
+
+std::string DoReset(const Args& a) {
+	std::string err;
+	if (!LoadStaticData(err)) return Error(err);
+
+	unsigned seed = (unsigned)ArgI(a, "seed", 0);
+	std::string group = ArgS(a, "group", "default");
+	std::string dir = ArgS(a, "course", "bunny_hill");
+	int wind = (int)ArgI(a, "wind", 0);
+	std::size_t light = (std::size_t)ArgI(a, "light", 0);
+	bool mirror = ArgI(a, "mirror", 0) != 0;
+	rl.dt = (float)ArgF(a, "dt", RL_DEFAULT_DT);
+	if (rl.dt <= 0.0f || rl.dt > 0.1f) return Error("dt must be in (0, 0.1]");
+
+	std::unordered_map<std::string, CCourseList>::iterator g = Course.CourseLists.find(group);
+	if (g == Course.CourseLists.end()) return Error("unknown course group: " + group);
+	TCourse* course = nullptr;
+	for (std::size_t i = 0; i < g->second.size(); i++)
+		if (g->second[i].dir == dir) course = &g->second[i];
+	if (course == nullptr) return Error("unknown course: " + group + "/" + dir);
+
+	std::srand(seed);
+	Course.currentCourseList = &g->second;
+	g_game.course = course;
+	g_game.cup = nullptr;
+	g_game.race = nullptr;
+	g_game.game_type = PRACTICING;
+	g_game.mirrorred = mirror;
+	g_game.light_id = light;
+	g_game.snow_id = 0;		// snow is a particle effect; physics is unaffected
+	g_game.wind_id = wind;
+	g_game.theme_id = course->music_theme;
+	g_game.force_treemap = false;
+
+	if (!Course.LoadCourse(course)) return Error("could not load course " + dir);
+	g_game.location_id = Course.GetEnv();
+
+	// CIntro::Enter, minus the camera, snow and music.
+	CControl* ctrl = g_game.player->ctrl;
+	const TVector2d& start_pt = Course.GetStartPoint();
+	ctrl->orientation_initialized = false;
+	ctrl->view_init = false;
+	ctrl->cpos.x = start_pt.x;
+	ctrl->cpos.z = start_pt.y;
+
+	CKeyframe* startframe = g_game.character->GetKeyframe(START);
+	if (startframe->loaded)
+		startframe->Init(ctrl->cpos, -0.05, g_game.character->shape);
+
+	g_game.herring = 0;
+	g_game.score = 0;
+	g_game.time = 0.f;
+	g_game.race_result = -1;
+	g_game.raceaborted = false;
+	ctrl->Init();
+	ctrl->cvel = TVector3d(0, 0, 0);
+	for (std::size_t i = 0; i < Course.NocollArr.size(); i++)
+		if (Course.NocollArr[i].collectable != -1)
+			Course.NocollArr[i].collectable = 1;
+	InitWind();
+
+	// CIntro::Loop: play the start animation at the fixed step so the
+	// player ends up where the rendered game puts them.
+	if (startframe->loaded) {
+		int guard = 0;
+		while (startframe->active && guard++ < 10000)
+			startframe->Update(rl.dt);
+	}
+
+	Racing.HeadlessEnter();
+	rl.tick = 0;
+	rl.have_course = true;
+	rl.group = group;
+	rl.dir = dir;
+	return Observation(CourseFinished());
+}
+
+std::string DoStep(const Args& a) {
+	if (!rl.have_course) return Error("reset first");
+	float turn = (float)ArgF(a, "turn", 0.0);
+	bool brake = ArgI(a, "brake", 0) != 0;
+	bool paddle = ArgI(a, "paddle", 0) != 0;
+	bool jump = ArgI(a, "jump", 0) != 0;
+	long ticks = ArgI(a, "ticks", 1);
+	float dt = (float)ArgF(a, "dt", rl.dt);
+	if (ticks < 1 || ticks > RL_MAX_TICKS) return Error("ticks out of range");
+	if (dt <= 0.0f || dt > 0.1f) return Error("dt must be in (0, 0.1]");
+	if (!std::isfinite(turn)) return Error("turn must be finite");
+
+	bool done = CourseFinished();
+	for (long i = 0; i < ticks && !done; i++) {
+		Racing.HeadlessStep(turn, brake, paddle, jump, dt);
+		rl.tick++;
+		done = CourseFinished();
+	}
+	return Observation(done);
+}
+
+bool ParseLine(const std::string& line, std::string& cmd, Args& args) {
+	std::istringstream is(line);
+	if (!(is >> cmd)) return false;
+	std::string tok;
+	while (is >> tok) {
+		std::string::size_type eq = tok.find('=');
+		if (eq == std::string::npos) args[tok] = "1";
+		else args[tok.substr(0, eq)] = tok.substr(eq + 1);
+	}
+	return true;
+}
+
+} // namespace
+
+int RunRlBridge(std::streambuf* proto_out) {
+	std::ostream proto(proto_out);
+	proto << std::setprecision(12);
+
+	std::string line;
+	while (std::getline(std::cin, line)) {
+		std::string cmd;
+		Args args;
+		if (!ParseLine(line, cmd, args)) continue;
+		std::string reply;
+		if (cmd == "info") reply = DoInfo();
+		else if (cmd == "reset") reply = DoReset(args);
+		else if (cmd == "step") reply = DoStep(args);
+		else if (cmd == "quit") break;
+		else reply = Error("unknown command: " + cmd);
+		proto << reply << '\n';
+		proto.flush();
+	}
+	return 0;
+}
