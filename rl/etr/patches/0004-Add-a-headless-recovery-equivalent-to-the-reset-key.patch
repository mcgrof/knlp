diff --git a/src/racing.cpp b/src/racing.cpp
index 9ff939e..56e15c3 100644
--- a/src/racing.cpp
+++ b/src/racing.cpp
@@ -38,11 +38,15 @@ GNU General Public License for more details.
 #include "physics.h"
 #include "tux.h"
 #include "rl_replay.h"
+#include "reset.h"
 #include <algorithm>
 
 #define MAX_JUMP_AMT 1.0
 #define ROLL_DECAY 0.2
 #define JUMP_MAX_START_HEIGHT 0.30
+// CReset runs for TOTAL_RESET_TIME seconds of race clock before handing
+// control back; a headless recovery pays the same.
+#define RL_RECOVER_TIME 1.0
 
 CRacing Racing;
 
@@ -465,6 +469,35 @@ void CRacing::HeadlessEnter() {
 	g_game.finish = false;
 }
 
+// Same relocation CReset::Loop performs when the player presses R: go to
+// the nearest reset point behind the player, or half a course-width back
+// and 10 m up the hill when the course defines none, then re-init. The
+// race clock advances by the reset animation's duration, so recovering
+// costs time exactly as it does in the rendered game.
+bool CRacing::HeadlessRecover() {
+	CControl *ctrl = g_game.player->ctrl;
+	if (g_game.finish) return false;
+
+	int best_loc = -1;
+	for (std::size_t i = 0; i < Course.NocollArr.size(); i++) {
+		if (Course.NocollArr[i].type.reset_point && Course.NocollArr[i].pt.z > ctrl->cpos.z) {
+			if (best_loc == -1 || Course.NocollArr[i].pt.z < Course.NocollArr[best_loc].pt.z)
+				best_loc = (int)i;
+		}
+	}
+	if (best_loc == -1 || Course.NocollArr[best_loc].pt.z <= ctrl->cpos.z) {
+		ctrl->cpos.x = Course.GetDimensions().x / 2.0;
+		ctrl->cpos.z = std::min(ctrl->cpos.z + 10, -1.0);
+	} else {
+		ctrl->cpos.x = Course.NocollArr[best_loc].pt.x;
+		ctrl->cpos.z = Course.NocollArr[best_loc].pt.z;
+	}
+	ctrl->view_init = false;
+	ctrl->Init();
+	g_game.time += RL_RECOVER_TIME;
+	return true;
+}
+
 void CRacing::HeadlessStep(float turn, bool brake, bool paddle, bool jump, float time_step) {
 	CControl *ctrl = g_game.player->ctrl;
 
