index 56ed331..22947dc 100644
--- a/src/rl_replay.cpp
+++ b/src/rl_replay.cpp
@@ -31,6 +31,7 @@ GNU General Public License for more details.
 #endif
 
 #include "rl_replay.h"
+#include "rl_bridge.h"
 #include "bh.h"
 #include "course.h"
 #include "game_ctrl.h"
@@ -41,7 +42,11 @@ GNU General Public License for more details.
 #include <iomanip>
 #include <iostream>
 #include <sstream>
