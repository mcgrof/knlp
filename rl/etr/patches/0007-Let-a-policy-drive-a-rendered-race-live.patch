 	} else if (argc >= 3 && std::strcmp(argv[1], "--rl-replay") == 0) {
 		// --rl-replay TRACE [LOG]: rendered playback of a recorded trace
 		if (!RlReplay::Load(argv[2], argc >= 4 ? argv[3] : ""))
