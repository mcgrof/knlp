 #include <vector>
+#include <netdb.h>
+#include <sys/socket.h>
+#include <unistd.h>
 
 namespace {
 
@@ -52,6 +57,10 @@ struct Action {
 };
 
 bool active = false;
+bool live = false;
+int live_fd = -1;
+std::ofstream trace_out;
+std::string live_buf;
 bool autoquit = false;
 float dt = 1.0f / 60.0f;
 unsigned seed = 0;
@@ -129,6 +138,82 @@ bool Load(const std::string& trace_path, const std::string& log_path) {
 	return true;
 }
 
+// One line from the policy socket, or empty at end of stream.
+std::string LiveLine() {
+	for (;;) {
+		std::string::size_type nl = live_buf.find('\n');
+		if (nl != std::string::npos) {
+			std::string line = live_buf.substr(0, nl);
+			live_buf.erase(0, nl + 1);
+			return line;
+		}
+		char buf[4096];
+		ssize_t n = read(live_fd, buf, sizeof buf);
+		if (n <= 0) return std::string();
+		live_buf.append(buf, (std::size_t)n);
+	}
+}
+
+bool LiveSend(const std::string& s) {
+	std::string out = s + "\n";
+	std::size_t off = 0;
+	while (off < out.size()) {
+		ssize_t n = write(live_fd, out.data() + off, out.size() - off);
+		if (n <= 0) return false;
+		off += (std::size_t)n;
+	}
+	return true;
+}
+
+bool Connect(const std::string& hostport, const std::string& trace_path,
+             const std::string& log_path) {
+	std::string host = hostport;
+	std::string port = "5077";
+	std::string::size_type c = hostport.rfind(':');
+	if (c != std::string::npos) {
+		host = hostport.substr(0, c);
+		port = hostport.substr(c + 1);
+	}
+	struct addrinfo hints;
+	std::memset(&hints, 0, sizeof hints);
+	hints.ai_family = AF_UNSPEC;
+	hints.ai_socktype = SOCK_STREAM;
+	struct addrinfo* res = nullptr;
+	if (getaddrinfo(host.c_str(), port.c_str(), &hints, &res) != 0 || res == nullptr) {
+		std::cerr << "rl-live: cannot resolve " << host << ':' << port << '\n';
+		return false;
+	}
+	live_fd = socket(res->ai_family, res->ai_socktype, res->ai_protocol);
+	if (live_fd < 0 || connect(live_fd, res->ai_addr, res->ai_addrlen) != 0) {
+		std::cerr << "rl-live: cannot connect to " << host << ':' << port << '\n';
+		freeaddrinfo(res);
+		return false;
+	}
+	freeaddrinfo(res);
+
+	// The policy dictates the race the way a trace header does.
+	if (!LiveSend("hello")) return false;
+	std::string header = LiveLine();
+	if (header.empty()) {
+		std::cerr << "rl-live: policy sent no race header\n";
+		return false;
+	}
+	Header(header);
+	if (!trace_path.empty()) {
+		trace_out.open(trace_path);
+		trace_out << "# etr rl trace v1\n" << header << '\n';
+	}
+	if (!log_path.empty()) {
+		logfile.open(log_path);
+		logfile << std::setprecision(12);
+	}
+	live = true;
+	active = true;
+	std::cerr << "rl-live: " << host << ':' << port << " drives " << group << '/' << course
+	          << " seed " << seed << " dt " << dt << '\n';
+	return true;
+}
+
 bool Active() { return active; }
 float Dt() { return dt; }
 bool AutoQuit() { return autoquit; }
@@ -171,8 +256,29 @@ bool SetupRace() {
 }
 
 Step Apply(bool& stick_turn, float& stick_turnfact, bool& paddle, bool& brake, bool& charge) {
-	if (next >= actions.size()) return END;
-	const Action& a = actions[next++];
+	Action a;
+	if (live) {
+		// Hand the policy the same observation the bridge produces, and take
+		// back one trace line: four control values, or R for the reset key.
+		if (!LiveSend(RlObservationJson())) return END;
+		std::string reply = LiveLine();
+		if (reply.empty()) return END;
+		if (trace_out.is_open()) trace_out << reply << '\n';
+		if (reply[0] == 'R' || reply[0] == 'r') {
+			a.recover = true;
+		} else {
+			std::istringstream is(reply);
+			int b = 0, p = 0, j = 0;
+			if (!(is >> a.turn >> b >> p >> j)) return END;
+			a.brake = b != 0;
+			a.paddle = p != 0;
+			a.jump = j != 0;
+			a.recover = false;
+		}
+	} else {
+		if (next >= actions.size()) return END;
+		a = actions[next++];
+	}
 	if (a.recover) return RECOVER;
 	stick_turn = a.turn != 0.0f;
 	stick_turnfact = clamp(-1.0f, a.turn, 1.0f);
@@ -193,6 +299,14 @@ void LogTick(const CControl* ctrl) {
 }
 
 void Close() {
+	if (live_fd >= 0) {
+		close(live_fd);
+		live_fd = -1;
+	}
+	if (trace_out.is_open()) {
+		trace_out.flush();
+		trace_out.close();
+	}
 	if (logfile.is_open()) {
 		logfile.flush();
 		logfile.close();
