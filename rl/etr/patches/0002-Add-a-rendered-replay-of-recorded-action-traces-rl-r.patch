diff --git a/src/rl_replay.cpp b/src/rl_replay.cpp
new file mode 100644
index 0000000..fee3fb6
--- /dev/null
+++ b/src/rl_replay.cpp
@@ -0,0 +1,195 @@
+/* --------------------------------------------------------------------
+EXTREME TUXRACER
+
+Rendered replay of a recorded action trace (--rl-replay).
+
+Trace format (one action per physics tick):
+
+  # etr rl trace v1
+  course=bunny_hill group=default seed=7 dt=0.0166667 wind=0 light=0
+      mirror=0 autoquit=0
+  <turn> <brake> <paddle> <jump>
+  ...
+
+The game runs its normal rendered states but every loop iteration
+advances the physics by exactly dt, so the replayed race is the same
+computation the headless bridge performed for the same trace.
+
+This program is free software; you can redistribute it and/or
+modify it under the terms of the GNU General Public License
+as published by the Free Software Foundation; either version 2
+of the License, or (at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+---------------------------------------------------------------------*/
+
+#ifdef HAVE_CONFIG_H
+#include <etr_config.h>
+#endif
+
+#include "rl_replay.h"
+#include "bh.h"
+#include "course.h"
+#include "game_ctrl.h"
+#include "physics.h"
+#include "tux.h"
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <sstream>
+#include <vector>
+
+namespace {
+
+struct Action {
+	float turn;
+	bool brake, paddle, jump;
+};
+
+bool active = false;
+bool autoquit = false;
+float dt = 1.0f / 60.0f;
+unsigned seed = 0;
+int wind = 0, light = 0, mirror = 0;
+std::string course = "bunny_hill";
+std::string group = "default";
+std::vector<Action> actions;
+std::size_t next = 0;
+long tick = 0;
+std::ofstream logfile;
+
+void Header(const std::string& line) {
+	std::istringstream is(line);
+	std::string tok;
+	while (is >> tok) {
+		std::string::size_type eq = tok.find('=');
+		if (eq == std::string::npos) continue;
+		std::string k = tok.substr(0, eq), v = tok.substr(eq + 1);
+		if (k == "course") course = v;
+		else if (k == "group") group = v;
+		else if (k == "seed") seed = (unsigned)std::atol(v.c_str());
+		else if (k == "dt") dt = (float)std::atof(v.c_str());
+		else if (k == "wind") wind = std::atoi(v.c_str());
+		else if (k == "light") light = std::atoi(v.c_str());
+		else if (k == "mirror") mirror = std::atoi(v.c_str());
+		else if (k == "autoquit") autoquit = std::atoi(v.c_str()) != 0;
+	}
+}
+
+} // namespace
+
+namespace RlReplay {
+
+bool Load(const std::string& trace_path, const std::string& log_path) {
+	std::ifstream in(trace_path);
+	if (!in) {
+		std::cerr << "rl-replay: cannot open " << trace_path << '\n';
+		return false;
+	}
+	std::string line;
+	bool header_seen = false;
+	while (std::getline(in, line)) {
+		if (line.empty() || line[0] == '#') continue;
+		if (!header_seen) {
+			Header(line);
+			header_seen = true;
+			continue;
+		}
+		std::istringstream is(line);
+		Action a;
+		int b = 0, p = 0, j = 0;
+		if (!(is >> a.turn >> b >> p >> j)) continue;
+		a.brake = b != 0;
+		a.paddle = p != 0;
+		a.jump = j != 0;
+		actions.push_back(a);
+	}
+	if (!header_seen || actions.empty()) {
+		std::cerr << "rl-replay: no header or no actions in " << trace_path << '\n';
+		return false;
+	}
+	if (!log_path.empty()) {
+		logfile.open(log_path);
+		logfile << std::setprecision(12);
+	}
+	active = true;
+	std::cerr << "rl-replay: " << actions.size() << " ticks on " << group << '/' << course
+	          << " seed " << seed << " dt " << dt << '\n';
+	return true;
+}
+
+bool Active() { return active; }
+float Dt() { return dt; }
+bool AutoQuit() { return autoquit; }
+
+bool SetupRace() {
+	std::unordered_map<std::string, CCourseList>::iterator g = Course.CourseLists.find(group);
+	if (g == Course.CourseLists.end()) {
+		std::cerr << "rl-replay: unknown course group " << group << '\n';
+		return false;
+	}
+	TCourse* c = nullptr;
+	for (std::size_t i = 0; i < g->second.size(); i++)
+		if (g->second[i].dir == course) c = &g->second[i];
+	if (c == nullptr) {
+		std::cerr << "rl-replay: unknown course " << course << '\n';
+		return false;
+	}
+	Players.AllocControl(0);
+	g_game.player = Players.GetPlayer(0);
+	g_game.character = nullptr;
+	for (std::size_t i = 0; i < Char.CharList.size(); i++)
+		if (Char.CharList[i].shape != nullptr) {
+			g_game.character = &Char.CharList[i];
+			break;
+		}
+	if (g_game.character == nullptr) return false;
+	Course.currentCourseList = &g->second;
+	g_game.course = c;
+	g_game.cup = nullptr;
+	g_game.race = nullptr;
+	g_game.game_type = PRACTICING;
+	g_game.mirrorred = mirror != 0;
+	g_game.light_id = (std::size_t)light;
+	g_game.snow_id = 0;
+	g_game.wind_id = wind;
+	g_game.theme_id = c->music_theme;
+	g_game.force_treemap = false;
+	std::srand(seed);
+	return true;
+}
+
+bool Apply(bool& stick_turn, float& stick_turnfact, bool& paddle, bool& brake, bool& charge) {
+	if (next >= actions.size()) return false;
+	const Action& a = actions[next++];
+	stick_turn = a.turn != 0.0f;
+	stick_turnfact = clamp(-1.0f, a.turn, 1.0f);
+	paddle = a.paddle;
+	brake = a.brake;
+	charge = a.jump;
+	return true;
+}
+
+void LogTick(const CControl* ctrl) {
+	tick++;
+	if (!logfile.is_open()) return;
+	logfile << "{\"tick\":" << tick << ",\"time\":" << g_game.time
+	    << ",\"pos\":[" << ctrl->cpos.x << ',' << ctrl->cpos.y << ',' << ctrl->cpos.z << ']'
+	    << ",\"vel\":[" << ctrl->cvel.x << ',' << ctrl->cvel.y << ',' << ctrl->cvel.z << ']'
+	    << ",\"herring\":" << g_game.herring << ",\"collisions\":" << ctrl->collisions
+	    << ",\"finish\":" << (g_game.finish ? "true" : "false") << "}\n";
+}
+
+void Close() {
+	if (logfile.is_open()) {
+		logfile.flush();
+		logfile.close();
+	}
+	std::cerr << "rl-replay: finished after " << tick << " ticks, race time " << g_game.time << '\n';
+}
+
+} // namespace RlReplay
