# SPDX-License-Identifier: MIT
KMESH_SELECTED := $(strip $(foreach v,TRACE RESIDENCY FORK SERVING RESTORE CASCADE NATIVE CONTRACTS REGISTERED,\
	$(if $(filter y,$(CONFIG_KNLP_REPRODUCE_KMESH_$(v))),$(v))))
ifneq ($(word 2,$(KMESH_SELECTED)),)
$(error Select one KMesh workload: $(KMESH_SELECTED))
endif

KMESH_TRACE_PY ?= $(PYTHON)
KMESH_TRACE_CONFIG ?= $(CONFIG_FILE)
.PHONY: kmesh-trace-audit kmesh-trace-plan kmesh-trace-test

kmesh-trace-audit kmesh-trace-plan:
	@"$(KMESH_TRACE_PY)" -m tools.reproduce.kmesh_residency.audit --config "$(KMESH_TRACE_CONFIG)" $(if $(filter kmesh-trace-plan,$@),--plan,)

kmesh-trace-test:
	@"$(KMESH_TRACE_PY)" -m unittest discover -s tests -p test_kmesh_trace.py -v

ifeq ($(CONFIG_KNLP_REPRODUCE_KMESH_TRACE),y)
.DEFAULT_GOAL := kmesh-trace-audit
endif

KMESH_RESIDENCY_PY ?= $(PYTHON)
.PHONY: kmesh-residency kmesh-residency-plan kmesh-residency-test
kmesh-residency kmesh-residency-plan:
	@"$(KMESH_RESIDENCY_PY)" -m tools.reproduce.kmesh_residency.run --config "$(CONFIG_FILE)" $(if $(filter kmesh-residency-plan,$@),--plan,)

kmesh-residency-test:
	@"$(KMESH_RESIDENCY_PY)" -m unittest discover -s tests -p test_kmesh_residency.py -v

ifeq ($(CONFIG_KNLP_REPRODUCE_KMESH_RESIDENCY),y)
.DEFAULT_GOAL := kmesh-residency
endif

KMESH_HEADROOM_ROOT ?= results/kmesh-tot
KMESH_HEADROOM_OUTPUT ?= results/kmesh-headroom.json
.PHONY: kmesh-headroom kmesh-headroom-test
kmesh-headroom:
	@"$(KMESH_RESIDENCY_PY)" -m tools.reproduce.kmesh_residency.headroom "$(KMESH_HEADROOM_ROOT)" --output "$(KMESH_HEADROOM_OUTPUT)"

kmesh-headroom-test:
	@"$(KMESH_RESIDENCY_PY)" -m unittest discover -s tests -p test_kmesh_headroom.py -v

.PHONY: kmesh-workload-test
kmesh-workload-test:
	@"$(KMESH_RESIDENCY_PY)" -m unittest discover -s tests -p test_kmesh_workload.py -v

KMESH_FORK_PY ?= $(PYTHON)
KMESH_FORK_CONFIG ?= .config
KMESH_FORK_DIR := tools/reproduce/kmesh_forks

.PHONY: kmesh-fork kmesh-fork-plan kmesh-fork-contracts \
	kmesh-fork-verify kmesh-fork-test kmesh-serving kmesh-serving-plan kmesh-serving-verify
.NOTPARALLEL: kmesh-fork kmesh-fork-contracts kmesh-fork-verify

kmesh-fork:
	@"$(KMESH_FORK_PY)" $(KMESH_FORK_DIR)/run.py --config "$(KMESH_FORK_CONFIG)" run

kmesh-fork-plan kmesh-fork-contracts kmesh-fork-verify:
	@"$(KMESH_FORK_PY)" $(KMESH_FORK_DIR)/run.py --config "$(KMESH_FORK_CONFIG)" $(patsubst kmesh-fork-%,%,$@)

kmesh-fork-test:
	@"$(KMESH_FORK_PY)" -m unittest discover -s tests/kmesh_forks -v

kmesh-serving kmesh-serving-plan kmesh-serving-verify:
	@"$(KMESH_FORK_PY)" $(KMESH_FORK_DIR)/serving_run.py --config "$(KMESH_FORK_CONFIG)" $(if $(filter kmesh-serving,$@),run,$(patsubst kmesh-serving-%,%,$@))

ifeq ($(CONFIG_KNLP_REPRODUCE_KMESH_FORK),y)
.DEFAULT_GOAL := kmesh-fork
endif

ifeq ($(CONFIG_KNLP_REPRODUCE_KMESH_SERVING),y)
.DEFAULT_GOAL := kmesh-serving
endif

KMESH_RESTORE_PY ?= $(PYTHON)
KMESH_RESTORE_CONFIG ?= $(CONFIG_FILE)
KMESH_RESTORE_DIR := tools/reproduce/kmesh_restore

.PHONY: kmesh-restore kmesh-restore-plan kmesh-restore-verify
.NOTPARALLEL: kmesh-restore

kmesh-restore kmesh-restore-plan kmesh-restore-verify:
	@"$(KMESH_RESTORE_PY)" $(KMESH_RESTORE_DIR)/entry.py --config "$(KMESH_RESTORE_CONFIG)" $(if $(filter kmesh-restore,$@),run,$(patsubst kmesh-restore-%,%,$@))

ifeq ($(CONFIG_KNLP_REPRODUCE_KMESH_RESTORE),y)
.DEFAULT_GOAL := kmesh-restore
endif

KMESH_CASCADE_PY ?= $(PYTHON)
KMESH_CASCADE_CONFIG ?= $(CONFIG_FILE)
KMESH_CASCADE_DIR := tools/reproduce/kmesh_cascade

.PHONY: kmesh-cascade kmesh-cascade-plan kmesh-cascade-verify
.NOTPARALLEL: kmesh-cascade

kmesh-cascade kmesh-cascade-plan kmesh-cascade-verify:
	@"$(KMESH_CASCADE_PY)" $(KMESH_CASCADE_DIR)/run.py --config "$(KMESH_CASCADE_CONFIG)" $(if $(filter kmesh-cascade,$@),run,$(patsubst kmesh-cascade-%,%,$@))

ifeq ($(CONFIG_KNLP_REPRODUCE_KMESH_CASCADE),y)
.DEFAULT_GOAL := kmesh-cascade
endif

KMESH_REGISTERED_PY ?= $(PYTHON)
.PHONY: kmesh-registered kmesh-registered-plan kmesh-registered-verify kmesh-registered-controls kmesh-registered-storage-pair
.NOTPARALLEL: kmesh-registered kmesh-registered-storage-pair
kmesh-registered kmesh-registered-plan kmesh-registered-verify kmesh-registered-controls kmesh-registered-storage-pair:
	@"$(KMESH_REGISTERED_PY)" -m tools.reproduce.kmesh_registered.launch --config "$(CONFIG_FILE)" $(if $(filter kmesh-registered,$@),run,$(patsubst kmesh-registered-%,%,$@))

ifeq ($(CONFIG_KNLP_REPRODUCE_KMESH_REGISTERED),y)
ifeq ($(CONFIG_KNLP_KMESH_REGISTERED_STORAGE_PAIR),y)
.DEFAULT_GOAL := kmesh-registered-storage-pair
else
.DEFAULT_GOAL := kmesh-registered
endif
endif

KMESH_NATIVE_PY ?= $(PYTHON)
.PHONY: kmesh-native kmesh-native-plan kmesh-native-verify kmesh-native-test
.NOTPARALLEL: kmesh-native
kmesh-native kmesh-native-plan kmesh-native-verify:
	@"$(KMESH_NATIVE_PY)" -m tools.reproduce.kmesh_native.run --config "$(CONFIG_FILE)" $(if $(filter kmesh-native,$@),run,$(patsubst kmesh-native-%,%,$@))

kmesh-native-test:
	@"$(PYTHON)" -m unittest discover -s tests -p test_kmesh_native.py -v

ifeq ($(CONFIG_KNLP_REPRODUCE_KMESH_NATIVE),y)
.DEFAULT_GOAL := kmesh-native
endif

KMESH_CONTRACTS_PY ?= $(PYTHON)
.PHONY: kmesh-contracts kmesh-contracts-plan kmesh-contracts-verify kmesh-contracts-test
.NOTPARALLEL: kmesh-contracts
kmesh-contracts kmesh-contracts-plan kmesh-contracts-verify:
	@"$(KMESH_CONTRACTS_PY)" -m tools.reproduce.kmesh_contracts.run --config "$(CONFIG_FILE)" $(if $(filter kmesh-contracts,$@),run,$(patsubst kmesh-contracts-%,%,$@))

kmesh-contracts-test:
	@"$(PYTHON)" -m unittest discover -s tests -p test_kmesh_contracts.py -v

ifeq ($(CONFIG_KNLP_REPRODUCE_KMESH_CONTRACTS),y)
.DEFAULT_GOAL := kmesh-contracts
endif
