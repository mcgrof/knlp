# Exact isolated-cartridge baseline on one A100-class GPU. The input parquets
# and records are staged separately and supplied through PAPER_DATA_DIR and
# RECORDS_DIR. Run under tmux with CUDA_VISIBLE_DEVICES pinned to a reserved GPU.
CONFIG_CARTRIDGES_CAS=y
CONFIG_CARTRIDGES_CAS_SMOKE=y
CONFIG_CARTRIDGES_CAS_MODEL="Qwen/Qwen3-8B"
CONFIG_CARTRIDGES_CAS_NUM_PATIENTS=1
CONFIG_CARTRIDGES_CAS_CONVOS_PER_PATIENT=4420
CONFIG_CARTRIDGES_CAS_MIN_PROB_MASS="0.998"
CONFIG_CARTRIDGES_CAS_KV_TOKENS=632
CONFIG_CARTRIDGES_CAS_LR="0.1"
CONFIG_CARTRIDGES_CAS_GLOBAL_BATCH=128
CONFIG_CARTRIDGES_CAS_STEPS=5000
CONFIG_CARTRIDGES_CAS_EPOCHS=80
CONFIG_CARTRIDGES_CAS_COMPILE_FLEX=n
CONFIG_CARTRIDGES_CAS_PHASE_SYNTH=n
CONFIG_CARTRIDGES_CAS_PHASE_TRAIN_ISOLATED=n
CONFIG_CARTRIDGES_CAS_PHASE_COLLAPSE=n
CONFIG_CARTRIDGES_CAS_PHASE_TRAIN_JOINT=n
CONFIG_CARTRIDGES_CAS_PHASE_RESCUE=n
CONFIG_CARTRIDGES_CAS_PHASE_CONTROL_SCREEN=n
CONFIG_CARTRIDGES_CAS_PHASE_OPT_ABLATION=n
CONFIG_CARTRIDGES_CAS_PHASE_PAPER_REGIME=y
CONFIG_CARTRIDGES_CAS_PAPER_PATIENTS="patient_02"
CONFIG_CARTRIDGES_CAS_PAPER_KV_DIVISOR=20
CONFIG_CARTRIDGES_CAS_PAPER_EVAL_RUNS=3
