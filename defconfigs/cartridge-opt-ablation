# Cartridge optimizer ablation: AdamW vs SOAP on stored-target
# cartridge training, matched arms, smallest real cartridge
# (Qwen3-0.6B student, one LongHealth patient).
# The frozen forward dominates the step, so the optimizer-step share
# of wall-clock is small; the report's optimizer-share column is the
# measured overhead ratio that decides whether SOAP is affordable.
# SOAP's eigenbasis refresh needs a deterministic backward: run on
# NVIDIA (e.g. one A100), not on ROCm/W7900.
# Requires a stored self-study parquet: set DATA_PARQUET, or enable
# the synth phase. Records can be staged offline in RECORDS_DIR; the
# strict eval accepts LONGHEALTH_JSON for offline hosts.
CONFIG_CARTRIDGES_CAS=y
CONFIG_CARTRIDGES_CAS_SMOKE=y
CONFIG_CARTRIDGES_CAS_MODEL="Qwen/Qwen3-0.6B"
CONFIG_CARTRIDGES_CAS_NUM_PATIENTS=2
CONFIG_CARTRIDGES_CAS_CONVOS_PER_PATIENT=8000
CONFIG_CARTRIDGES_CAS_MIN_PROB_MASS="0.998"
CONFIG_CARTRIDGES_CAS_KV_TOKENS=512
CONFIG_CARTRIDGES_CAS_LR="1e-3"
CONFIG_CARTRIDGES_CAS_GLOBAL_BATCH=4
CONFIG_CARTRIDGES_CAS_STEPS=2000
CONFIG_CARTRIDGES_CAS_EPOCHS=4
CONFIG_CARTRIDGES_CAS_COMPILE_FLEX=y
CONFIG_CARTRIDGES_CAS_PHASE_SYNTH=n
CONFIG_CARTRIDGES_CAS_PHASE_TRAIN_ISOLATED=n
CONFIG_CARTRIDGES_CAS_PHASE_COLLAPSE=n
CONFIG_CARTRIDGES_CAS_PHASE_TRAIN_JOINT=n
CONFIG_CARTRIDGES_CAS_PHASE_RESCUE=n
CONFIG_CARTRIDGES_CAS_PHASE_OPT_ABLATION=y
CONFIG_CARTRIDGES_CAS_OPT_ARMS="adamw soap"
CONFIG_CARTRIDGES_CAS_OPT_PATIENT="patient_02"
CONFIG_CARTRIDGES_CAS_OPT_STEPS=300
CONFIG_CARTRIDGES_CAS_OPT_ACCUM=8
CONFIG_CARTRIDGES_CAS_OPT_LR="2e-2"
CONFIG_CARTRIDGES_CAS_OPT_SEED=0
CONFIG_CARTRIDGES_CAS_OPT_CHECKPOINT_AT="10,50,100,200,300"
CONFIG_CARTRIDGES_CAS_OPT_SOAP_PRECOND_FREQ=10
