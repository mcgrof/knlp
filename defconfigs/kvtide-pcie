# KVTide physical-NVMe comparison on an already booted premap kernel.
# Add the disposable controller addresses and the explicit rebind opt-in
# after loading this configuration. See tools/reproduce/kvtide/README.md.
CONFIG_KVTIDE=y
CONFIG_KVTIDE_MODE_PCIE=y
CONFIG_KVTIDE_PCIE_BDFS=""
CONFIG_KVTIDE_PCIE_NSID=1
CONFIG_KVTIDE_PCIE_ALLOW_REBIND=n
CONFIG_KVTIDE_PCIE_DRIVER_VFIO=y
CONFIG_KVTIDE_PCIE_UPCIE=y
CONFIG_KVTIDE_PCIE_SPDK=y
CONFIG_KVTIDE_PCIE_LINUX=y
CONFIG_KVTIDE_PCIE_FIXED=y
CONFIG_KVTIDE_PCIE_PREMAP=y
CONFIG_KVTIDE_PCIE_IOBUF_ORDER=9
CONFIG_KVTIDE_PCIE_IOBUF_FOLIOS=64
CONFIG_KVTIDE_PCIE_UPCIE_CUDA=y
CONFIG_KVTIDE_PCIE_XNVME_GIT="https://github.com/xnvme/xnvme.git"
CONFIG_KVTIDE_PCIE_XNVME_REF="main"
CONFIG_KVTIDE_PCIE_SPDK_GIT="https://github.com/spdk/spdk.git"
CONFIG_KVTIDE_PCIE_SPDK_REF="master"
CONFIG_KVTIDE_PCIE_PROFILES="aisio kv"
CONFIG_KVTIDE_PCIE_AISIO_SIZES="512 4096 8192"
CONFIG_KVTIDE_PCIE_AISIO_QDS="128"
CONFIG_KVTIDE_PCIE_AISIO_THREADS="1 2 3 4"
CONFIG_KVTIDE_PCIE_KV_SIZES="4096 16384 32768 65536 131072 1048576 2097152"
CONFIG_KVTIDE_PCIE_KV_QDS="1 16 64 128"
CONFIG_KVTIDE_PCIE_KV_THREADS="1"
CONFIG_KVTIDE_PCIE_CPUS="4 5 6 7"
CONFIG_KVTIDE_PCIE_NQUEUES=1
CONFIG_KVTIDE_PCIE_SECS=10
CONFIG_KVTIDE_PCIE_WARMUPS=1
CONFIG_KVTIDE_PCIE_REPS=5
CONFIG_KVTIDE_PCIE_HUGEPAGES=5120
CONFIG_KVTIDE_SRC_DIR="/data/kvtide"
