# Subliminal learning on MNIST, loss-convention bridge: the same paper
# MLP and five seeds as subliminal-mnist-paper-diag, but with ordinary
# per-image mean cross-entropy and KL. The architecture comparison uses
# this convention only if the plain MLP still transfers under it.
CONFIG_SUBLIMINAL_ARCH_PAPER_MLP=y
CONFIG_SUBLIMINAL_PROTOCOL_PER_EXAMPLE=y
CONFIG_SUBLIMINAL_SEEDS="1101 1102 1103 1104 1105"
CONFIG_SUBLIMINAL_MAX_SECONDS=3600
CONFIG_SUBLIMINAL_LEARNING=y
CONFIG_DEVICE="cuda"
CONFIG_SUBLIMINAL_TEACHER_EPOCHS=5
CONFIG_SUBLIMINAL_STUDENT_EPOCHS=5
CONFIG_SUBLIMINAL_BATCH_SIZE=1024
CONFIG_SUBLIMINAL_LR="0.0003"
CONFIG_SUBLIMINAL_AUX_OUTPUTS=3
CONFIG_SUBLIMINAL_NOISE_SAMPLES=60000
CONFIG_SUBLIMINAL_PRECISION="fp32"
# CONFIG_SUBLIMINAL_COMPILE is not set
CONFIG_SUBLIMINAL_SAVE_CHECKPOINTS=y
CONFIG_SUBLIMINAL_STUDENT_LOSS_LEGACY=y
