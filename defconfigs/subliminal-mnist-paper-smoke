# Subliminal learning on MNIST, smoke test of the plain paper MLP.
# Two seeds, 6,000 training images, 2,000 test images, 6,000 noise
# images and two epochs per stage. Exercises every stage and receipt in
# about a minute; a smoke run cannot issue a scientific verdict.
CONFIG_SUBLIMINAL_ARCH_PAPER_MLP=y
CONFIG_SUBLIMINAL_PROTOCOL_UPSTREAM=y
CONFIG_SUBLIMINAL_SEEDS="1101 1102"
CONFIG_SUBLIMINAL_LOGICAL_COHORT=100
CONFIG_SUBLIMINAL_SMOKE=y
CONFIG_SUBLIMINAL_TRAIN_LIMIT=6000
CONFIG_SUBLIMINAL_TEST_LIMIT=2000
CONFIG_SUBLIMINAL_MAX_SECONDS=900
CONFIG_SUBLIMINAL_LEARNING=y
CONFIG_DEVICE="cuda"
CONFIG_SUBLIMINAL_TEACHER_EPOCHS=2
CONFIG_SUBLIMINAL_STUDENT_EPOCHS=2
CONFIG_SUBLIMINAL_BATCH_SIZE=1024
CONFIG_SUBLIMINAL_LR="0.0003"
CONFIG_SUBLIMINAL_AUX_OUTPUTS=3
CONFIG_SUBLIMINAL_NOISE_SAMPLES=6000
CONFIG_SUBLIMINAL_PRECISION="fp32"
# CONFIG_SUBLIMINAL_COMPILE is not set
CONFIG_SUBLIMINAL_SAVE_CHECKPOINTS=y
CONFIG_SUBLIMINAL_STUDENT_LOSS_LEGACY=y
