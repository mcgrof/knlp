# LayerRoPE on existing block input gains; five-seed pilot.
# Subliminal learning on MNIST: the one-stream residual baseline.
# Backbone is a width-256, four-block pre-LayerNorm residual MLP with a
# 784-to-256 stem and one 256-to-13 head; per-image mean losses.
# Five engineering pilot seeds.
CONFIG_SUBLIMINAL_ARCH_RESIDUAL_MLP=y
CONFIG_SUBLIMINAL_PROTOCOL_PER_EXAMPLE=y
CONFIG_SUBLIMINAL_SEEDS="1101 1102 1103 1104 1105"
CONFIG_SUBLIMINAL_WIDTH=256
CONFIG_SUBLIMINAL_BLOCKS=4
CONFIG_SUBLIMINAL_STREAMS=4
CONFIG_SUBLIMINAL_SINKHORN_ITERS=20
CONFIG_SUBLIMINAL_MHC_INIT_LOGIT="4.0"
CONFIG_SUBLIMINAL_LN_EPS="1e-5"
CONFIG_SUBLIMINAL_MAX_SECONDS=7200
CONFIG_SUBLIMINAL_LEARNING=y
CONFIG_DEVICE="cuda"
CONFIG_SUBLIMINAL_TEACHER_EPOCHS=5
CONFIG_SUBLIMINAL_STUDENT_EPOCHS=5
CONFIG_SUBLIMINAL_BATCH_SIZE=1024
CONFIG_SUBLIMINAL_LR="0.0003"
CONFIG_SUBLIMINAL_AUX_OUTPUTS=3
CONFIG_SUBLIMINAL_NOISE_SAMPLES=60000
CONFIG_SUBLIMINAL_PRECISION="fp32"
# CONFIG_SUBLIMINAL_COMPILE is not set
CONFIG_SUBLIMINAL_SAVE_CHECKPOINTS=y
CONFIG_SUBLIMINAL_LAYERROPE=y
CONFIG_SUBLIMINAL_STUDENT_LOSS_EXACT_CANCEL=y
