# Weight-loading I/O: header inventory only.
#
# Reads every shard header of the configured checkpoints by HTTP range
# request and computes the byte layout, the selected units and their
# page footprints. No shard is downloaded, no device is traced, no root
# is needed. Good first run on any machine with network access:
#
#   make defconfig-weight-io-inventory
#   make
#
# The tables land in CONFIG_KNLP_WEIGHT_IO_ROOT/stageA/INVENTORY.md.
CONFIG_KNLP_WEIGHT_IO=y
CONFIG_KNLP_WEIGHT_IO_ROOT="./results/weight-io"
CONFIG_KNLP_WEIGHT_IO_REPOS="Qwen/Qwen3-0.6B Qwen/Qwen2.5-7B-Instruct Qwen/Qwen2.5-7B-Instruct-AWQ Qwen/Qwen3-Next-80B-A3B-Instruct deepseek-ai/DeepSeek-V3 moonshotai/Kimi-K2-Instruct meta-llama/Llama-3.1-405B"
CONFIG_KNLP_WEIGHT_IO_CONTROL_REPOS=""
CONFIG_KNLP_WEIGHT_IO_FETCH_COMPACT=n
CONFIG_KNLP_WEIGHT_IO_GROUPS=""
CONFIG_KNLP_WEIGHT_IO_INTENT=n
CONFIG_KNLP_WEIGHT_IO_IDLE_PROBE=n
CONFIG_KNLP_WEIGHT_IO_GPU=n
