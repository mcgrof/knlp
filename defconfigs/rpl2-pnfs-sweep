# pNFS lab on one host: many clients reading shared hot objects.
#
# The same lab as rpl2-pnfs-lab, plus up to 16 extra clients, each its
# own NFS client identity in its own namespace.  For each client count
# the clients read the same 16 objects at once, with stock LMCache and
# with held descriptors.  Each cell records metadata-server operations
# and CPU per object read, throughput and latency.  The default fixture
# uses 256 KiB objects, which NFS reads buffered, so the metadata path
# dominates; set CONFIG_KNLP_RPL2_PNFS_SWEEP_FIXTURE="rpl2-8m" for 8 MiB
# direct reads.
#
#   make RPL2P_ROOT=/disk/rpl2p RPL2_OUTPUT=$HOME/rpl2-pnfs-records
CONFIG_KNLP_REPRODUCE_RPL2=y
CONFIG_KNLP_RPL2_PNFS_SWEEP=y
CONFIG_KNLP_RPL2_PNFS_ROOT=""
CONFIG_KNLP_RPL2_PNFS_OUTPUT_DIR=""
CONFIG_KNLP_RPL2_PNFS_PYTHON=""
CONFIG_KNLP_RPL2_PNFS_LMCACHE_REPO="https://github.com/mcgrof/LMCache.git"
CONFIG_KNLP_RPL2_PNFS_LMCACHE_REF="2026-10-28-feature-fs-native-held-fd"
CONFIG_KNLP_RPL2_PNFS_LMCACHE_COMMIT="3e4b3839ce47655e2d0d33cad3f66d4bf920d767"
CONFIG_KNLP_RPL2_PNFS_PREFIX="rpl2p"
CONFIG_KNLP_RPL2_PNFS_NET="10.247.0"
CONFIG_KNLP_RPL2_PNFS_DATA_SERVERS=1
CONFIG_KNLP_RPL2_PNFS_HELD_CAPACITY=64
CONFIG_KNLP_RPL2_PNFS_CLIENTS="1 2 4 8 16"
CONFIG_KNLP_RPL2_PNFS_SECONDS=20
CONFIG_KNLP_RPL2_PNFS_SWEEP_FIXTURE="rpl2-256k"
CONFIG_KNLP_RPL2_PNFS_REMOTE_CLIENTS=""
