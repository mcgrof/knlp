# Subliminal learning on MNIST, paper reproduction cohort: the
# 784-256-256-13 MLP, 100 independently initialized models under global
# seed 0, the reference script's loss reductions, 5 + 5 epochs, Adam 3e-4,
# batch 1,024. Different-initialization controls use independent
# alternate initializations rather than a permutation of the cohort.
# Models train 25 at a time; losses are divided by the logical cohort of
# 100 regardless of packing.
CONFIG_SUBLIMINAL_ARCH_PAPER_MLP=y
CONFIG_SUBLIMINAL_PROTOCOL_UPSTREAM=y
CONFIG_SUBLIMINAL_SEEDS=""
CONFIG_SUBLIMINAL_REFERENCE_MODELS=100
CONFIG_SUBLIMINAL_REFERENCE_SEED=0
CONFIG_SUBLIMINAL_LOGICAL_COHORT=100
CONFIG_SUBLIMINAL_PACK_SIZE=25
CONFIG_SUBLIMINAL_MAX_SECONDS=3600
CONFIG_SUBLIMINAL_LEARNING=y
CONFIG_DEVICE="cuda"
CONFIG_SUBLIMINAL_TEACHER_EPOCHS=5
CONFIG_SUBLIMINAL_STUDENT_EPOCHS=5
CONFIG_SUBLIMINAL_BATCH_SIZE=1024
CONFIG_SUBLIMINAL_LR="0.0003"
CONFIG_SUBLIMINAL_AUX_OUTPUTS=3
CONFIG_SUBLIMINAL_NOISE_SAMPLES=60000
CONFIG_SUBLIMINAL_PRECISION="fp32"
# CONFIG_SUBLIMINAL_COMPILE is not set
CONFIG_SUBLIMINAL_SAVE_CHECKPOINTS=y
CONFIG_SUBLIMINAL_STUDENT_LOSS_LEGACY=y
