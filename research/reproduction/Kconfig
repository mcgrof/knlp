menu "Residual-path research reproduction"

config RESIDUAL_REPRODUCTION
	bool "Run the configured MNIST or TinyStories study"
	default n

if RESIDUAL_REPRODUCTION

config RESIDUAL_STUDY
	string "Study: mnist, null, layerrope, tinystories, depth, confirmation, cache, gsm8k, beta, time-budget, routing-audit"
	default "mnist"

config RESIDUAL_SMOKE
	bool "Bounded smoke test; cannot issue a confirmation verdict"
	default n

config RESIDUAL_DEVICE
	string "Requested device: cpu or cuda"
	default "cuda"

config RESIDUAL_DATA_DIR
	string "Public dataset cache"
	default "~/.cache/knlp/residual-data"

config RESIDUAL_OUTPUT_DIR
	string "New output directory"
	default "~/knlp-residual-runs"

config RESIDUAL_CHECKPOINT_DIR
	string "Checkpoint root; empty keeps checkpoints within the run"
	default ""

config RESIDUAL_CPU_PYTHON
	string "Python interpreter for independent CPU evaluations"
	default "python3"

config RESIDUAL_SEEDS
	string "Optional seeds for a targeted MNIST study"
	default ""
	help
	  Aggregate studies retain their distinct original seed sets.
	  The seven-row confirmation always uses seeds 76411 through 76418.

config RESIDUAL_MAX_SECONDS
	int "Total elapsed-time limit; zero disables the limit"
	default 86400
	range 0 604800

config RESIDUAL_CPU_THREADS
	int "CPU thread limit"
	default 8
	range 1 64

config RESIDUAL_KV_CACHE
	bool "Evaluate KV-cache fake quantization after TinyStories training"
	default y
	help
	  Reuse saved final checkpoints. Keep the three-seed residual/mHC
	  cohort separate from the eight-seed depth-code confirmation.
	  No quantization-aware training or packed-kernel benchmark runs.

config RESIDUAL_CACHE_DEPTH_RUN
	string "Saved depth-screen reproduction run for cache-only evaluation"
	default ""
	help
	  The top-level external run directory containing depth-screen/ and
	  data/. Used by the cache-only and GSM8K presets; no training repeats.

config RESIDUAL_CACHE_CONFIRMATION_RUN
	string "Saved confirmation reproduction run for cache-only evaluation"
	default ""
	help
	  The top-level external run directory containing confirmation/.
	  Supply either saved cohort or both. Reports stay separate.

config RESIDUAL_TIME_CARD
	string "Frozen equal-time run card (JSON)"
	default ""

config RESIDUAL_TIME_RESOURCE
	string "Bounded, owner-authorized hardware/resource decision (JSON)"
	default ""

config RESIDUAL_TIME_ACTION
	string "Equal-time action: qualify or run"
	default "qualify"

config RESIDUAL_AUDIT_INPUTS
	string "Frozen routing replay inputs (JSON)"
	default ""

config RESIDUAL_AUDIT_ACTION
	string "Routing follow-up: audit or pilot"
	default "audit"

config RESIDUAL_AUDIT_RESULT
	string "Completed routing audit result for a conditional pilot"
	default ""

config RESIDUAL_AUDIT_PROPOSAL
	string "Frozen pilot proposal with fresh-seed provenance"
	default ""

endif
endmenu
