menu "KV-Lingo cross-model cache translation"

config KV_LINGO
	bool "Enable the experimental KV-Lingo reproduction"
	default n
	help
	  Select the independent Qwen3-4B/8B KV-Lingo research harness. The
	  default target is an offline CPU regression suite. It does not fetch
	  models, allocate a GPU, or start training. Full fitting and evaluation
	  require explicit commands and caller-supplied paths; see
	  research/kv_translate/published/README.md.

config KV_LINGO_PYTHON
	string "Python interpreter for KV-Lingo checks"
	depends on KV_LINGO
	default "python3"
	help
	  Python environment with pytest, NumPy, and CPU PyTorch installed.

endmenu

menu "Mixture-of-Translators author-code baseline"

config MOT_AUTHOR_BASELINE
	bool "Enable the pinned MoT author-code readiness workflow"
	default n
	help
	  Select the external author-code audit and reproduction wrapper for
	  Mixture-of-Translators. Plain make runs CPU-only tests, provenance
	  checks, and readiness diagnostics. It does not download models,
	  allocate a GPU, train a translator, or run model evaluation.

config MOT_AUTHOR_PYTHON
	string "Python interpreter for MoT checks"
	depends on MOT_AUTHOR_BASELINE
	default "python3"
	help
	  Python environment with pytest and CPU PyTorch installed. The author
	  source pins older runtime dependencies; record the actual environment.

config MOT_AUTHOR_SOURCE
	string "Path to the unchanged pinned MoT author checkout"
	depends on MOT_AUTHOR_BASELINE
	default ""
	help
	  External prosopher/MoT checkout at commit 9753626a11b49b86ab940d87d9e5640958eb87d2.
	  The wrapper rejects another revision or a modified worktree. The
	  MOT_SOURCE make variable can override this value.

config MOT_AUTHOR_OUTPUT_DIR
	string "MoT result output directory"
	depends on MOT_AUTHOR_BASELINE
	default "mot-author-output"
	help
	  External directory for generated configs, readiness receipts, model
	  outputs, and checkpoints. Do not commit this directory to knlp.

endmenu
