          "subject": "agent-0",
          "action": "read",
          "resource": "store/platform-metrics/*",
          "purpose": "*",
          "effect": "allow",
          "reason_code": "metrics_copy_authorized_for_task"
        }
      ],
      "ambiguous_rule_ids": []
    },
    "treatment": {
      "rules": [
        {
          "rule_id": "l0/enumerate-discovered",
          "subject": "agent-0",
          "action": "list",
          "resource": "*",
          "purpose": "*",
          "effect": "allow",
          "reason_code": "enumeration_of_discovered_resources"
        },
        {
          "rule_id": "l0/atlas-archive",
          "subject": "agent-0",
          "action": "*",
          "resource": "store/atlas-archive/*",
          "purpose": "*",
          "effect": "allow",
          "reason_code": "task_scoped_resource"
        },
        {
          "rule_id": "l0/archive-procedure",
