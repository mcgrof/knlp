{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chores.knlp.io/schemas/profile-v1.json",
  "title": "Chores status profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "surface",
    "state",
    "summary",
    "claim_scope",
    "refresh_seconds",
    "workstreams"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1, "maxLength": 80 },
    "surface": { "enum": ["public", "private"] },
    "state": { "type": "string", "minLength": 1, "maxLength": 40 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "claim_scope": { "type": "string", "minLength": 1, "maxLength": 500 },
    "refresh_seconds": { "type": "integer", "minimum": 10, "maximum": 300 },
    "repository_scope": { "$ref": "#/$defs/repository_scope" },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workstream" }
    }
  },
  "$defs": {
    "repository_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_paths"],
      "properties": {
        "include_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "exclude_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  }
}
