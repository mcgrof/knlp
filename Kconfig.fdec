# SPDX-License-Identifier: MIT
# fdec -- fight-decode brick composition. See docs/fdec.md.
#
# Names a point in the decode-optimization compatibility matrix: a model plus a
# set of enabled bricks. scripts/fdec_run.py runs scripts/fdec_compose.py on
# every subset of the enabled bricks (quality and byte accounting, any GPU).
# Kernel throughput is measured in the serving-stack profiles (CUDA).

menu "Fight-decode (fdec) brick composition"

config FDEC_ENABLE
	bool "Enable fdec brick-composition regime"
	default n
	help
	  Compose bleeding-edge decode optimizations and verify they compose
	  without mismatch. See docs/fdec.md. Selected by defconfig-fdec.

if FDEC_ENABLE

config FDEC_MODELS
	string "Models to run the matrix on (space separated)"
	default "Qwen/Qwen2.5-7B meta-llama/Llama-3.2-3B"
	help
	  Hugging Face ids of dense decoder models. The matrix runs once
	  per model.

config FDEC_ROOT
	string "Result directory"
	default "results/fdec"

config FDEC_DEVICE
	string "Torch device"
	default "cuda:0"

config FDEC_EVAL_SEQS
	int "Held-out evaluation sequences (512 tokens each)"
	default 16

config FDEC_CALIB_SEQS
	int "Calibration sequences for the LM-head certificate"
	default 128

config FDEC_TASK_GSM_LIMIT
	int "GSM8K problems for make fdec-tasks (0 means all 1,319)"
	default 0

config FDEC_TASK_MMLU_PER_SUBJECT
	int "MMLU items per subject for make fdec-tasks (0 means all)"
	default 0
	help
	  MMLU has 57 subjects and 14,042 test items. The published task
	  tables use every item. A small value is for a harness check only.

config FDEC_TASK_GSM_BATCH
	int "GSM8K prompts per batch for make fdec-tasks"
	default 16

config FDEC_TASK_MMLU_BATCH
	int "MMLU prompts per batch for make fdec-tasks"
	default 8
	help
	  8 fits a 7B model on a GPU with 24 GiB. Every cell of one result
	  file must use the same batch sizes; the task script checks this.

config FDEC_INT8_WEIGHTS
	bool "Brick: int8 weights"
	default y
	help
	  Group-wise int8 for every linear layer in the decoder blocks,
	  with no calibration. Weights-pool brick. The Fisher sensitivity
	  study found int8 to be the near-lossless point; int4 was not.

config FDEC_ASYM_KV
	bool "Brick: asymmetric K16/V8 KV quantization"
	default y
	help
	  Keep keys at 16 bits and quantize values to FP8. KV-pool brick.
	  Does not apply to linear-attention models.

config FDEC_KV_SCALE
	string "FP8 scale of the cached values (one or tensor)"
	default "one"
	help
	  "one" casts the values to FP8 as they are. This is the default
	  of the vLLM FP8 cache. "tensor" first divides each value tensor
	  by its largest magnitude over 448, which uses the whole FP8
	  range and gives a perplexity about 0.1% lower.

config FDEC_LMHEAD_CERT
	bool "Brick: certified LM-head decode"
	default y
	help
	  A low-rank int8 shadow of the output head bounds every logit, so
	  the decoder reads only the vocabulary slabs that can hold the
	  argmax. The returned token is exact. LM-head-pool brick.

config FDEC_LINEAR_ATTN
	bool "Brick: linear-attention model class"
	default n
	help
	  Use a linear-attention model (Gated DeltaNet / Trellis / Mamba2 / RWKV).
	  Removes the KV pool -- the structural escape from the dense-attention
	  offload bandwidth bound. Asymmetric KV quant does not apply.

endif # FDEC_ENABLE

endmenu
