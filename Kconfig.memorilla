# SPDX-License-Identifier: MIT
menuconfig KNLP_REPRODUCE_MEMORILLA
	bool "Memorilla checkpoint inference and stress replay"
	default n
	help
	  Run released author checkpoints with the original prompts, reader,
	  decoder and scorers. No training target is provided.

if KNLP_REPRODUCE_MEMORILLA
choice
	prompt "Memorilla inference path"
config KNLP_MEM_AUTHOR
	bool "Original author runtime and mmap store"
config KNLP_MEM_PORT_CONTROL
	bool "Original mmap store on a separately recorded runtime"
config KNLP_MEM_LMCACHE
	bool "Shared artifact catalog and LMCache embedding store"
endchoice
config KNLP_MEM_ROOT
	string "Local persistent source, model and run root"
	default "build/memorilla"
config KNLP_MEM_BENCHMARK
	string "Benchmark name or all"
	default "pubmedqa"
config KNLP_MEM_BATCH
	int "Generation batch size"
	range 1 256
	default 32
config KNLP_MEM_SCHEDULING
	string "Offline scheduling: runtime, inprocess, batch"
	default "runtime" if KNLP_MEM_AUTHOR
	default "inprocess"
	help
	  Runtime preserves upstream defaults. Inprocess disables V1 engine
	  multiprocessing for repeatable offline scheduling. Batch keeps V1
	  multiprocessing and pauses scheduling while a complete batch is
	  enqueued; it requires the level-0 pause/enqueue APIs. Original author
	  mode accepts runtime only. Neither mode promises equality between
	  different batch shapes or engine/hardware versions.
config KNLP_MEM_SINGLETON_REFERENCE
	bool "Isolated single-request numerical reference"
	depends on !KNLP_MEM_AUTHOR
	default n
	help
	  Require batch size one, inprocess scheduling, one engine sequence
	  and disabled prefix caching. This removes neighboring requests and
	  prefix reuse from the numerical reference. It is a correctness
	  control, not a throughput configuration or a paper-score target.
config KNLP_MEM_GPU_FRACTION
	string "Decoder GPU memory fraction"
	default "0.6"
config KNLP_MEM_SCORER_FRACTION
	string "Scoring encoder GPU memory fraction"
	default "0.3"
config KNLP_MEM_POOL_BYTES
	int "LMCache host arena bytes"
	default 67108864
config KNLP_MEM_INPUT_PIPELINE
	string "Document batch assembly: author, leased-fp16, leased-bf16"
	default "author"
	help
	  The port and LMCache paths may copy document banks directly into an
	  owned batch. leased-fp16 removes the intermediate bank clone while
	  preserving the original padded conversion. leased-bf16 casts valid
	  rows directly into the final batch and initializes padding there.
	  Both preserve complete reader inputs and bounded source lifetimes.
	  Original author mode accepts author only.
config KNLP_MEM_ARTIFACT_MODE
	string "LMCache artifact setup: import or attach"
	default "import"
	help
	  Import validates and publishes document collections. Attach opens
	  an explicitly pinned imported set without reconstructing collections.
	  Payload misses still verify complete bytes and catalog identity.
config KNLP_MEM_ARTIFACT_SET_MANIFEST
	string "Receipt from memorilla-import for attach mode"
	default ""
config KNLP_MEM_ENGINE_JSON
	string "Port-only vLLM engine options JSON"
	default "{}"
	help
	  Explicit engine options for the port control and LMCache path only.
	  For example, enforce_eager can qualify an existing native build.
	  Original author mode rejects overrides. Sampling stays unchanged.
config KNLP_MEM_REQUESTS
	int "Stress requests per benchmark"
	range 1 10000000
	default 1000
config KNLP_MEM_CLIENTS
	int "Concurrent bank-fetch clients before each ordered decoder batch"
	range 1 128
	default 1
	help
	  Port stress replay can fetch collections concurrently while preserving
	  the original collator and complete decoder batch order. This exercises
	  shared-bank storage contention, not concurrent engine.generate calls.
	  Original author mode requires one client.
config KNLP_MEM_PATTERN
	string "Stress pattern: sequential, shuffle, random, hot"
	default "shuffle"
config KNLP_MEM_BANK_SWAP
	bool "Stress one question against different document collections"
	default n
	help
	  Synthetic inference isolation workload. Keep question zero and
	  replay the selected collection schedule. These pairs are not scored
	  as paper benchmark examples. Compare them against native inference.
config KNLP_MEM_DIAGNOSTICS
	bool "Hash collated inputs, reader outputs and decoder prompt tensors"
	default n
	help
	  Diagnostic replay only. Copy intermediate tensors to CPU and hash
	  them per request to locate output mismatches. Extra synchronization
	  changes timing; do not use this mode to claim a performance result.
config KNLP_MEM_SEED
	int "Request and evaluation seed"
	default 23
config KNLP_MEM_ROWS
	int "Stress working set in questions; zero means full split"
	range 0 1000000
	default 0
config KNLP_MEM_EVICT_EVERY
	int "Evict adapter residency every N batches; zero disables"
	range 0 1000000
	default 0
endif
