menu "Exact-prefix reasoning forks"

config KNLP_REPRODUCE_KMESH_REGISTERED
	bool "Replay serial model repair from registered native spans"
	default n
	help
	  Use the pinned Qwen workload and separate-process CPU-L1 span service.
	  Keep reference lookup/storage as scheduling controls and feed real
	  model repair from registered restores. This duplicates storage and
	  does not measure serving latency or DMA-BUF performance.

if KNLP_REPRODUCE_KMESH_REGISTERED

config KNLP_KMESH_REGISTERED_ROUTE
	string "Model input route: reference or registered"
	default "registered"

config KNLP_KMESH_REGISTERED_VLLM_SOURCE
	string "Clean pinned vLLM checkout"
	default ""

config KNLP_KMESH_REGISTERED_LMCACHE_SOURCE
	string "Clean pinned LMCache checkout and matching native extensions"
	default ""

config KNLP_KMESH_REGISTERED_WHEEL_PACKAGE
	string "Pinned vLLM wheel package directory"
	default ""

config KNLP_KMESH_REGISTERED_MODEL_DIR
	string "Pinned local Qwen snapshot"
	default ""

config KNLP_KMESH_REGISTERED_TRACE
	string "Frozen synthetic TokenDance trace.jsonl"
	default ""

config KNLP_KMESH_REGISTERED_MANIFEST
	string "Frozen trace manifest.json"
	default ""

config KNLP_KMESH_REGISTERED_OUTPUT
	string "Fresh capture directory outside source checkouts"
	default ""

config KNLP_KMESH_REGISTERED_REFERENCE
	string "Independently verified serial-reference artifacts directory"
	default ""

config KNLP_KMESH_REGISTERED_VERIFICATION
	string "Independent reference verified.json"
	default ""

config KNLP_KMESH_REGISTERED_ORDINARY_RESULT
	string "Historical ordinary-model result.json for failure controls"
	default ""

config KNLP_KMESH_REGISTERED_ORDINARY_VERIFICATION
	string "Independent historical verification binding that ordinary result"
	default ""

endif

config KNLP_REPRODUCE_KMESH_CONTRACTS
	bool "Qualify CPU ownership, sessions and registered-context lifetime"
	default n
	help
	  Run the pinned LMCache CPU ownership controls and transport suites.
	  Require every selected case and test phase to execute successfully.
	  GPUs are hidden. This does not qualify KMesh serving or device I/O.

if KNLP_REPRODUCE_KMESH_CONTRACTS

config KNLP_KMESH_CONTRACTS_PROFILE
	string "CPU source profile"
	default "contexts"
	help
	  Keep the context/registered-state gates or select retained rotary
	  transfers, or ordered-registration. Each profile pins its own source
	  and required cases. Ordered registration keeps serving disabled.
	  Select owned-raw-copy for partial raw import and cleanup lifetime.
	  Select managed-raw-context for checked context admission controls.
	  Select managed-raw-service for bounded service ownership controls.
	  Select native-spans for checked admission and host-buffer lifetimes.
	  Select interior-spans for arbitrary source-position admission.
	  Select registered-inputs for serial source/fallback and fused-layout controls.
	  Select registered-arenas for eager pinned and GPU source prerequisites.

config KNLP_KMESH_CONTRACTS_SOURCE
	string "Clean pinned LMCache source with its shared native extension"
	default ""

config KNLP_KMESH_CONTRACTS_VLLM_SOURCE
	string "Clean pinned vLLM checkout when the CPU profile requires it"
	default ""

config KNLP_KMESH_CONTRACTS_OUTPUT
	string "Fresh result directory outside all source checkouts"
	default ""

endif

config KNLP_REPRODUCE_KMESH_NATIVE
	bool "Qualify native paged-cache layouts and position recovery"
	default n
	help
	  Check the pinned LMCache executor and registered retrieve handlers
	  with synthetic BF16 payloads. Require every selected test to run;
	  skips cannot qualify a native result. No serving speed is measured.

if KNLP_REPRODUCE_KMESH_NATIVE

config KNLP_KMESH_NATIVE_PROFILE
	string "Native qualification profile"
	default "paged-cache"
	help
	  Select native paged-cache rotation or separate-process registered
	  tensor copying, or ordered-registration through public RPC servers.
	  Select raw-ipc-lifetime for checked raw mapping release and aliases.
	  Select raw-ipc-outcomes for native uncertainty and receiver counters.
	  Select owned-raw-copy for retained raw rotary import and cleanup.
	  Select managed-raw-context for checked CUDA context retirement.
	  Select managed-raw-service for public raw control and release RPCs.
	  Select native-spans for native store, shifted restore and physical drain.
	  Select interior-spans for multilayer NHD/HND interior-source gathers.
	  Select registered-inputs for fused K/V, native layer inputs and retirement.
	  Select registered-arenas for eager pinned-host and GPU canonical sources.
	  Each profile pins its source, binaries and cases.

config KNLP_KMESH_NATIVE_SOURCE
	string "Clean pinned LMCache source with matching native extensions"
	default ""

config KNLP_KMESH_NATIVE_OUTPUT
	string "Fresh output directory outside the source checkout"
	default ""

endif

config KNLP_REPRODUCE_KMESH_TRACE
	bool "Audit trace evidence for family residency on CPU"
	default n
	help
	  Measure input-text reuse and field coverage in pinned public traces.
	  Keep record spacing separate from measured invocation and fork times.
	  Missing lineage or cache observations cannot qualify a pressure result.

if KNLP_REPRODUCE_KMESH_TRACE

config KNLP_KMESH_TRACE_ROOT
	string "Trace checkout or captured invocation directory"
	default ""

config KNLP_KMESH_TRACE_OUTPUT
	string "Fresh audit output directory"
	default "results/kmesh-trace-audit"

config KNLP_KMESH_TRACE_MODE
	string "Trace format: lmcache or invocations"
	default "lmcache"

endif

config KNLP_REPRODUCE_KMESH_RESIDENCY
	bool "Qualify family references and capture branching workloads"
	default n
	help
	  Compare a bounded ancestor hold with stock prefix caching under a
	  controlled synthetic request order. Use CPU allocator metadata or
	  synchronous model capture. This does not replay a production trace.

if KNLP_REPRODUCE_KMESH_RESIDENCY

config KNLP_KMESH_RESIDENCY_MODE
	string "Qualification mode: cpu, serving or tot"
	default "cpu"

config KNLP_KMESH_RESIDENCY_SOURCE
	string "Clean qualified vLLM source directory"
	default ""

config KNLP_KMESH_RESIDENCY_MODEL
	string "Local model snapshot for serving capture"
	default ""

config KNLP_KMESH_RESIDENCY_WORKLOAD_SOURCE
	string "Pinned Tree of Thoughts source directory"
	default ""

config KNLP_KMESH_RESIDENCY_OUTPUT
	string "Fresh qualification output directory"
	default "results/kmesh-family-residency"

endif

config KNLP_REPRODUCE_KMESH_FORK
	bool "Enable the real vLLM CPU allocator experiment"
	default n
	help
	  Compare cached and uncached exact-prefix reasoning trees using
	  KVCacheManager metadata. This does not execute a model or GPU.

if KNLP_REPRODUCE_KMESH_FORK

