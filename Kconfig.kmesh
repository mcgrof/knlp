# SPDX-License-Identifier: MIT
menu "Exact-prefix reasoning fork accounting"

config KNLP_REPRODUCE_KMESH_FORK
	bool "Enable the real vLLM CPU allocator experiment"
	default n
	help
	  Compare cached and uncached exact-prefix reasoning trees using
	  KVCacheManager metadata. This does not execute a model or GPU.

if KNLP_REPRODUCE_KMESH_FORK

config KNLP_KMESH_FORK_PROFILE
	string "Runtime profile: historical or current"
	default "historical"
	help
	  Keep the workload fixed while selecting an explicit source/runtime
	  pair. The current profile runs locally with GPU visibility disabled.

config KNLP_KMESH_FORK_OUTPUT
	string "Fresh output directory"
	default "results/kmesh-forks"

config KNLP_KMESH_FORK_VLLM_SOURCE
	string "Clean pinned fork-accounting vLLM checkout"
	default ""

config KNLP_KMESH_FORK_RUNTIME_VOLUME
	string "Docker volume containing the pinned Python runtime"
	default ""

config KNLP_KMESH_FORK_DOCKER
	string "Container command prefix"
	default "docker"

config KNLP_KMESH_FORK_PYTHON
	string "Current profile's prepared native Python interpreter"
	default ""

config KNLP_KMESH_FORK_WHEEL_PACKAGE
	string "Current profile's matching installed vLLM package directory"
	default ""

endif

config KNLP_REPRODUCE_KMESH_SERVING
	bool "Replay exact-prefix forks through the current serving engine"
	default n
	help
	  Run the original warm, cold, burst, eviction and decode-fork cases
	  with a real model on an available GPU and the prepared runtime.

if KNLP_REPRODUCE_KMESH_SERVING

config KNLP_KMESH_SERVING_OUTPUT
	string "Fresh serving output directory"
	default "results/kmesh-serving"

config KNLP_KMESH_SERVING_VLLM_SOURCE
	string "Clean pinned serving-replay vLLM checkout"
	default ""

config KNLP_KMESH_SERVING_WHEEL_PACKAGE
	string "Matching installed vLLM wheel package"
	default ""

config KNLP_KMESH_SERVING_MODEL_DIR
	string "Pinned model snapshot directory"
	default ""

endif
endmenu
