config KNLP_REPRODUCE_KMESH_RESTORE
	bool "Compare host-staged and DMA-BUF ancestor restoration"
	default n
	help
	  Restore an exact-prefix ancestor through the production LMCache
	  multiprocess connector. Run transport measurements and optional
	  strict serving qualification on an available GPU.

if KNLP_REPRODUCE_KMESH_RESTORE

config KNLP_KMESH_RESTORE_OUTPUT
	string "Fresh restore output directory on qualified NVMe"
	default "results/kmesh-restore"

config KNLP_KMESH_RESTORE_VLLM_SOURCE
	string "Clean pinned serving-replay vLLM checkout"
	default ""

config KNLP_KMESH_RESTORE_LMCACHE_SOURCE
	string "Clean pinned restore-validation LMCache checkout"
	default ""

config KNLP_KMESH_RESTORE_MODEL_DIR
	string "Authenticated local model snapshot"
	default ""

config KNLP_KMESH_RESTORE_GPU_PROVIDER
	string "GPU buffer exporter: native or vulkan_rm"
	default "vulkan_rm"
	help
	  The RTX 4090 qualification uses the experimental Vulkan/RM provider.
	  Use native only after qualifying CUDA DMA-BUF export on the host.

config KNLP_KMESH_RESTORE_SECTION
	string "Scope: adapter, all, coldburst, singleflight, family, retained, prefetch"
	default "adapter"
	help
	  Adapter reproduces the qualified transport comparison. All also
	  runs the serving gate, which can reject cold-burst recomputation.
	  Coldburst compares simultaneous arrivals with a completed leader,
	  recording backend reads and live ancestor destination blocks.
	  Singleflight compares disabled and enabled exact-prefix load gates
	  on their separately pinned LMCache source, including backend reads.
	  Family releases children during a declared ancestor preload, against
	  reactive coalescing and a fully warm control, with unused-work checks.
	  Retained compares an engine preload against stock retained external-L1
	  prefetch followed by the same preload, including its storage work.
	  Prefetch compares read-once retained demand against early loading at
	  fixed request deadlines, with an independent-process pilot and confirmation.

if KNLP_KMESH_RESTORE_SECTION = "prefetch"

config KNLP_KMESH_RESTORE_PHASE
	string "Loading comparison: qualification, pilot, confirmation"
	default "qualification"

config KNLP_KMESH_RESTORE_QUALIFIED
	string "Accepted native qualification capture"
	default "results/kmesh-prefetch/qualification"

config KNLP_KMESH_RESTORE_PILOT
	string "Accepted complete pilot capture"
	default "results/kmesh-prefetch/pilot"

endif

endif

config KNLP_REPRODUCE_KMESH_CASCADE
	bool "Compare shared-prefix cascade attention on the current vLLM"
	default n
	help
	  Replay the original 8B reasoning family with disabled, natural and
	  forced cascade policies. Check actual kernel engagement separately
	  from timing and generated-token differences. Use an available GPU.

if KNLP_REPRODUCE_KMESH_CASCADE

config KNLP_KMESH_CASCADE_OUTPUT
	string "Fresh cascade output directory"
	default "results/kmesh-cascade"

config KNLP_KMESH_CASCADE_VLLM_SOURCE
	string "Clean pinned serving-replay vLLM checkout"
	default ""

config KNLP_KMESH_CASCADE_MODEL_DIR
	string "Authenticated Llama-3.1-8B-Instruct snapshot"
	default ""

endif
