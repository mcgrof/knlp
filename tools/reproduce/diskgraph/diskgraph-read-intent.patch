diff --git a/diskgraph-index/src/read_intent.rs b/diskgraph-index/src/read_intent.rs
new file mode 100644
index 0000000..6946efb
--- /dev/null
+++ b/diskgraph-index/src/read_intent.rs
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: Apache-2.0
+//! Opt-in Buffered I/O shape capture for the knlp reproduction.
+
+use serde_json::{json, Value};
+use std::collections::HashMap;
+use std::fs::{File, OpenOptions};
+use std::io::{BufWriter, Write};
+use std::sync::{Mutex, OnceLock};
+
+struct Capture {
+    output: BufWriter<File>,
+    files: HashMap<i32, u64>,
+}
+
+static CAPTURE: OnceLock<Option<Mutex<Capture>>> = OnceLock::new();
+
+fn capture() -> Option<&'static Mutex<Capture>> {
+    CAPTURE
+        .get_or_init(|| {
+            let path = std::env::var_os("KNLP_DISKGRAPH_INTENT")?;
+            let mut options = OpenOptions::new();
+            options.create_new(true).write(true);
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::OpenOptionsExt;
+                options.mode(0o600);
+            }
+            let mut log = Capture {
+                output: BufWriter::new(options.open(path).expect("create intent trace")),
+                files: HashMap::new(),
+            };
+            log.write(json!({"event":"meta","version":1,"clock":"CLOCK_MONOTONIC"}));
+            Some(Mutex::new(log))
+        })
+        .as_ref()
+}
+
+impl Capture {
+    fn write(&mut self, value: Value) {
+        serde_json::to_writer(&mut self.output, &value).expect("serialize intent trace");
+        self.output.write_all(b"\n").expect("write intent trace");
+        self.output.flush().expect("flush intent trace");
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn now() -> u64 {
+    let mut ts = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    assert_eq!(
+        unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) },
+        0
+    );
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) fn file(fd: i32, file: u64, size: u64) {
+    if let Some(log) = capture() {
+        let mut log = log.lock().expect("lock intent trace");
+        log.files.insert(fd, file);
+        log.write(json!({"event":"file","file":file,"size":size}));
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) fn ranges<I>(kind: &str, file: u64, ranges: I)
+where
+    I: IntoIterator<Item = (u64, u64)>,
+{
+    if let Some(log) = capture() {
+        let ranges: Vec<_> = ranges
+            .into_iter()
+            .filter(|(s, e)| s < e)
+            .map(|(start, end)| [start, end - start])
+            .collect();
+        if !ranges.is_empty() {
+            log.lock().expect("lock intent trace").write(json!({
+                "event":"demand","kind":kind,"file":file,"at_ns":now(),"ranges":ranges
+            }));
+        }
+    }
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) fn read_batch<I>(qd: u32, reads: I)
+where
+    I: IntoIterator<Item = (i32, u64, u64)>,
+{
+    if let Some(log) = capture() {
+        let mut log = log.lock().expect("lock intent trace");
+        let reads: Vec<_> = reads
+            .into_iter()
+            .map(|(fd, offset, size)| {
+                [
+                    *log.files.get(&fd).expect("registered Buffered edge file"),
+                    offset,
+                    size,
+                ]
+            })
+            .collect();
+        if !reads.is_empty() {
+            log.write(json!({
+                "event":"read_batch","at_ns":now(),"lane":unsafe { libc::syscall(libc::SYS_gettid) },
+                "qd":qd,"reads":reads
+            }));
+        }
+    }
+}
