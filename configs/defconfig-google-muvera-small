# SPDX-License-Identifier: MIT
# Official Google FDE construction; exact search in the knlp harness.
CONFIG_GOOGLE_MUVERA_SMALL=y
CONFIG_MUVERA_OUTPUT_BASE="/data/results-archive"
CONFIG_MUVERA_DEVICE="cuda:0"

# Reuse a trusted local cache directory, or leave empty to encode SciFact.
# Cache files are hashed. Historical torch caches do not record revisions.
CONFIG_GOOGLE_MUVERA_EMBEDDING_CACHE=""
CONFIG_MUVERA_DATASET_SCIFACT=y
CONFIG_MUVERA_ENABLE_COLBERTV2=y
CONFIG_MUVERA_COLBERTV2_MODEL="lightonai/colbertv2.0"
CONFIG_MUVERA_ENABLE_BGE_SMALL=y
CONFIG_MUVERA_BGE_MODEL="BAAI/bge-small-en-v1.5"

# Each triple is repetitions:SimHash bits:inner projection dimensions.
# Output dimension is repetitions * 2^bits * projection dimensions.
CONFIG_GOOGLE_MUVERA_FDE_CONFIGS="5:4:16 20:4:8 20:5:16"
CONFIG_GOOGLE_MUVERA_SEEDS="1"
CONFIG_GOOGLE_MUVERA_FILL_EMPTY=y
CONFIG_GOOGLE_MUVERA_FINAL_DIM=0
CONFIG_GOOGLE_MUVERA_FORMATS="fp32 fp16 int8"
CONFIG_GOOGLE_MUVERA_CANDIDATES="10 100"
CONFIG_GOOGLE_MUVERA_LENGTH_BINS="32 64 128 256 512 1024"

# Memory/cache measurements. This does not run a cold NVMe experiment.
CONFIG_MUVERA_SYSTEMS_BENCH=y
CONFIG_MUVERA_RECORD_SIZES="32 64 128 256 512 1024 1280 2048 4096 8192 16384"
CONFIG_MUVERA_SYSTEMS_SMALL_RECORDS=65536
CONFIG_MUVERA_SYSTEMS_RANDOM_READS=10000
CONFIG_MUVERA_SYSTEMS_TOPK=64
CONFIG_MUVERA_SYSTEMS_BATCH_SIZES="1 8 64"
CONFIG_MUVERA_SYSTEMS_PROJECTION_HIDDEN=4096
CONFIG_MUVERA_ENABLE_NVME_COLD_BENCH=n
