# SPDX-License-Identifier: MIT
# Make targets for the KVTide storage bench harness.
#
# Selecting one of:
#   make defconfig-kvtide-ab        both initiators, A/B bake-off (default)
#   make defconfig-kvtide-spdk      SPDK userspace initiator only
#   make defconfig-kvtide-xnvme     xNVMe io_uring_cmd initiator only
#   make defconfig-kvtide-nixl      A/B plus the NIXL XNVME_KV plugin tests
#   make defconfig-kvtide-ab-linux  A/B plus a kernel under test
#   make defconfig-kvtide-ab-linux-baremetal   same, allowed on bare metal
#   make defconfig-kvtide-pcie     physical xNVMe/SPDK/Linux comparison
#   make defconfig-kvtide-pcie-aisio   published AISIO control profile
#   make defconfig-kvtide-pcie-linux-baremetal   install premap kernel
# writes .config and enables CONFIG_KVTIDE.  Plain `make` after that runs
# the selected staged pipeline. The software-KV target stays up afterwards
# so cells can be re-run; `make kvtide-target-down` tears it down.
#
# kvtide-ab-linux adds a kvtide-linux stage before target-up: it fetches,
# builds and installs a kernel, then gates on running it (one reboot,
# then re-run `make`).  The tree/branch default to the blk_iobuf_pool v3
# series and can be overridden at defconfig time:
#   make defconfig-kvtide-ab-linux LINUX_TREE=<git url> LINUX_BRANCH=<ref>
# The kernel stage refuses bare metal unless the -baremetal defconfig
# (CONFIG_KVTIDE_LINUX_ALLOW_BAREMETAL=y) says otherwise; the perf
# harness itself runs anywhere, VM or metal.
#
# The software target runs in a QEMU guest without physical KV hardware.
# Physical mode instead uses only explicitly listed disposable NVMe PCI
# functions and requires CONFIG_KVTIDE_PCIE_ALLOW_REBIND=y.
#
# All knobs live in Kconfig.kvtide ("KVTide storage bench harness" menu).
# Host-specific overrides append to .config, e.g.:
#   echo 'CONFIG_KVTIDE_SRC_DIR="/home/me/kvtide"' >> .config
#
# See tools/reproduce/kvtide/README.md for the kdevops guest bring-up.

KVTIDE_SH := tools/reproduce/kvtide

.PHONY: kvtide kvtide-doctor kvtide-fetch kvtide-build kvtide-linux \
        kvtide-target-up kvtide-target-down kvtide-bench kvtide-nixl \
		kvtide-report kvtide-pcie-bind-kernel kvtide-pcie-bind-vfio \
		kvtide-pcie-bind-uio kvtide-pcie-bench kvtide-pcie-report

# When CONFIG_KVTIDE=y, plain `make` defaults to the kvtide pipeline.
# Otherwise the existing all: target is unaffected.
ifeq ($(CONFIG_KVTIDE),y)
.DEFAULT_GOAL := kvtide
endif

# With a kernel under test configured, gate the pipeline on running it
# (after everything is built, so one reboot resumes straight into the
# bench).
KVTIDE_LINUX_STAGE :=
ifeq ($(CONFIG_KVTIDE_LINUX),y)
KVTIDE_LINUX_STAGE := kvtide-linux
endif

ifeq ($(CONFIG_KVTIDE_MODE_PCIE),y)
kvtide: kvtide-doctor kvtide-fetch kvtide-build $(KVTIDE_LINUX_STAGE) \
	kvtide-pcie-bench kvtide-pcie-report
else
kvtide: kvtide-doctor kvtide-fetch kvtide-build $(KVTIDE_LINUX_STAGE) \
	kvtide-target-up kvtide-bench kvtide-report
endif

kvtide-doctor:
	@$(KVTIDE_SH)/doctor.sh

kvtide-fetch:
	@$(KVTIDE_SH)/fetch.sh

kvtide-build:
	@$(KVTIDE_SH)/build.sh

kvtide-linux:
	@$(KVTIDE_SH)/linux.sh

kvtide-target-up:
	@$(KVTIDE_SH)/target-up.sh

kvtide-target-down:
	@$(KVTIDE_SH)/target-down.sh

kvtide-bench:
	@$(KVTIDE_SH)/bench.sh

kvtide-nixl:
	@$(KVTIDE_SH)/nixl.sh

kvtide-report:
	@$(KVTIDE_SH)/report.sh

kvtide-pcie-bind-kernel:
	@$(KVTIDE_SH)/pcie-bind.sh kernel

kvtide-pcie-bind-vfio:
	@$(KVTIDE_SH)/pcie-bind.sh vfio

kvtide-pcie-bind-uio:
	@$(KVTIDE_SH)/pcie-bind.sh uio

kvtide-pcie-bench:
	@$(KVTIDE_SH)/pcie-bench.sh

kvtide-pcie-report:
	@$(KVTIDE_SH)/pcie-report.sh
